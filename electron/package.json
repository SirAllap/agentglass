{
  "name": "agentglass-electron",
  "private": true,
  "version": "0.14.0",
  "description": "Every AI coding agent on your machine, on one screen \u2014 live cost, tokens and tool calls across every provider, and a hold on anything dangerous until you say go.",
  "author": "SirAllap",
  "homepage": "https://github.com/SirAllap/agentglass",
  "repository": {
    "type": "git",
    "url": "https://github.com/SirAllap/agentglass.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "node build.mjs && electron-builder",
    "dist:linux": "node build.mjs && electron-builder --linux",
    "dist:dir": "node build.mjs && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "app.agentglass.desktop",
    "productName": "agentglass",
    "executableName": "agentglass",
    "artifactName": "agentglass_${version}_${arch}.${ext}",
    "directories": {
      "output": "dist-app"
    },
    "electronFuses": {
      "resetAdHocDarwinSignature": true,
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "enableNodeOptionsEnvironmentVariable": false
    },
    "files": [
      "main.js",
      "guest-guard.js",
      "browser-menu.js",
      "power.js",
      "preload.js",
      "icons/**"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "staging",
        "to": "."
      },
      {
        "from": "../hooks",
        "to": "hooks",
        "filter": [
          "**/*",
          "!__pycache__",
          "!__pycache__/**",
          "!*.pyc"
        ]
      },
      {
        "from": "../bin",
        "to": "bin"
      },
      {
        "from": "../skills",
        "to": "skills"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "SirAllap",
        "repo": "agentglass"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "icons/icon-512.png",
      "maintainer": "SirAllap <noreply@users.noreply.github.com>"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon.ico"
    }
  }
}
