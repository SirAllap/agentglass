    q.add_argument("--step", type=int, default=None, help="steps done")
    q.add_argument("--of", type=int, default=None, help="steps in all")
    q = pp.add_parser("answer", help="the person's answer to the plan's question")
    q.add_argument("id")
    q.add_argument("answer")
    for name, why in (("go", "let a run that waits start"), ("no-go", "decline a run that waits")):
        q = fs.add_parser(name, help=why)
        q.add_argument("id")
    q = fs.add_parser("resolve", help="answer one finding: fix, contest, ask or dismiss (contest and dismiss need --note); none clears it. The person's or the project's seat's only: anyone else is refused")
    q.add_argument("id")
