    q.add_argument("action", choices=("fix", "contest", "ask", "dismiss", "none"))
    q.add_argument("--note", default=None)
    p = sub.add_parser("flow", help="a project's flow and roster: read it, save it, add or edit a role, put roles on the path, undo the last write")
    fs = p.add_subparsers(dest="flverb", required=True)
    q = fs.add_parser("get", help="the flow in force for the project")
    q.add_argument("--root", default=os.getcwd(), help="the project (default: this directory)")
    q = fs.add_parser("set", help="save a whole flow from a JSON file ('-' reads stdin)")
    q.add_argument("file", help="a JSON flow, or - for stdin")
    q.add_argument("--root", default=os.getcwd(), help="the project (default: this directory)")
    q = fs.add_parser("undo", help="put back the flow from before the last write (the person's own window)")
    q.add_argument("--root", default=os.getcwd(), help="the project (default: this directory)")
    fr = fs.add_parser("role", help="add, rename or edit a role in the team").add_subparsers(dest="frverb", required=True)
    q = fr.add_parser("add", help="add a role; it is appended to the path (or after --after) unless --team-only")
    q.add_argument("id")
    q.add_argument("--name", required=True)
    q.add_argument("--does", required=True, help="one line: what the role does")
    q.add_argument("--prompt", required=True, help="the role's whole prompt")
    q.add_argument("--first-command", default=None, help="sent as the turn's own first line, e.g. /jira-fix-card {card}; {card} becomes the card key the worker was started with")
    q.add_argument("--policy-role", default=None, choices=["builder", "scout", "reviewer", "verifier"], help="a built-in kind; its chain is the policy's (one of this or --chain)")
    q.add_argument("--chain", default=None, help="its own chain, engine:model[,engine:model] (one of this or --policy-role)")
    q.add_argument("--stage", default=FLOW_DEFAULTS["stage"], help="a stage of this flow")
    q.add_argument("--ico", default=FLOW_DEFAULTS["ico"], help="an icon a block draws (a legacy name is read as the icon it became)")
    q.add_argument("--hue", default=FLOW_DEFAULTS["hue"], help="a colour token a block draws")
    q.add_argument("--tools", default=",".join(FLOW_DEFAULTS["tools"]), help=f"comma list (default {','.join(FLOW_DEFAULTS['tools'])})")
    q.add_argument("--reads-only", default=None, choices=["yes", "no"], help="look and read only; nothing it can change (default: no)")
    q.add_argument("--may-start-subagents", default=None, choices=["yes", "no"], help="may call the Agent tool, for a team skill that spawns reviewer subagents (default: no)")
    q.add_argument("--actor", default=None, choices=["person"], help="a person answers this step: nothing runs, so it takes no --chain or --policy-role")
    q.add_argument("--after", default=None, help="the role it follows on the path (default: the end)")
    q.add_argument("--team-only", action="store_true", help="in the team, off the path: no block")
    q.add_argument("--root", default=os.getcwd(), help="the project (default: this directory)")
    q = fr.add_parser("rename", help="change a role's label; an id never changes")
    q.add_argument("id")
    q.add_argument("name")
    q.add_argument("--root", default=os.getcwd(), help="the project (default: this directory)")
    q = fr.add_parser("edit", help="change one or more fields of a role; the id stays")
    q.add_argument("id")
    q.add_argument("--name", default=None)
    q.add_argument("--does", default=None)
    q.add_argument("--prompt", default=None)
    q.add_argument("--first-command", default=None, help="sent as the turn's own first line, e.g. /jira-fix-card {card}; empty clears it")
    q.add_argument("--policy-role", default=None, choices=["builder", "scout", "reviewer", "verifier"])
    q.add_argument("--chain", default=None, help="engine:model[,engine:model]; its own chain, or empty to clear it")
    q.add_argument("--stage", default=None)
    q.add_argument("--ico", default=None, help="an icon a block draws (a legacy name is read as the icon it became)")
    q.add_argument("--hue", default=None)
    q.add_argument("--tools", default=None, help="comma list, replacing the old one")
    q.add_argument("--allow", default=None, help="comma list of command prefixes, replacing the old one")
    q.add_argument("--reads-only", default=None, choices=["yes", "no"])
    q.add_argument("--may-start-subagents", default=None, choices=["yes", "no"], help="may call the Agent tool, for a team skill that spawns reviewer subagents")
    q.add_argument("--required", default=None, choices=["yes", "no"])
    q.add_argument("--actor", default=None, choices=["person", "none"], help="a person answers this step: nothing runs, and its chain is cleared; none clears it")
    q.add_argument("--root", default=os.getcwd(), help="the project (default: this directory)")
    fp = fs.add_parser("path", help="the suggested order of steps").add_subparsers(dest="fpverb", required=True)
    q = fp.add_parser("set", help="replace the whole path; arrows and hard rules whose ends leave it are dropped and listed")
    q.add_argument("ids", nargs="+")
    q.add_argument("--root", default=os.getcwd(), help="the project (default: this directory)")
    q = fp.add_parser("add", help="insert one role on the path, after --after or at the end")
    q.add_argument("id")
    q.add_argument("--after", default=None, help="the role it follows")
    q.add_argument("--root", default=os.getcwd(), help="the project (default: this directory)")
    p = sub.add_parser("notify", help="notifications: `notify test` sends one test note, routed as a real one")
    ns = p.add_subparsers(dest="nverb", required=True)
    q = ns.add_parser("test", help="one test notification after a delay, shown where a real one of that kind would; it says Test and where it went, and holds nothing")
    q.add_argument("--kind", choices=("news", "waits", "other"), required=True, help="news: agentglass news (a PR check); waits: an agent that waits on you (no real hold); other: another app's note")
    q.add_argument("--in", dest="delay", type=int, default=5, help="seconds to wait first, 0 to 60 (default 5), so you can switch to the view you want to test")
    p = sub.add_parser("settings", help="list, read or change the settings an agent may touch")
    ss = p.add_subparsers(dest="verb", required=True)
    ss.add_parser("list", help="every setting, the window's and the server's, with its class; and the requests waiting for the person")
    ss.add_parser("requests", help="the changes you asked for that wait for the person (a rootless ask reads back only to a chair, a plugin or a policy worker; a labelled machine-token ask waits for the person)")
    q = ss.add_parser("get")
    q.add_argument("id")
    q.add_argument("--root", default=None, help="the project, for a setting held per project (the chair, a project's policy)")
    q = ss.add_parser("set")
    q.add_argument("id")
    q.add_argument("--root", default=None, help="the project, for a setting held per project (the chair, a project's policy)")
    q.add_argument("value", help="true/false and numbers are read as such, unless the setting stores text (settings list says which); anything else is text")
    a = ap.parse_args(argv)

    if a.as_name and not NAME.match(a.as_name):
        print("agentglass-ui: --as is letters, digits and . _ : - (at most 64)", file=sys.stderr)
        return 2
    if a.cmd == "list":
        return emit(_list())
    if a.cmd == "state":
        return emit(run_door("ui.state", {}, a.as_name))
    if a.cmd == "freezes":
        return emit(freezes(a.lines))
    if a.cmd == "read":
        return emit(run_door("ui.read", {"panel": a.panel}, a.as_name))
    if a.cmd == "pr" and a.pverb in PR_DOOR_VERBS:
        return emit(run_pr_read(a.pverb, a.repo, a.number, a.as_name))
    if a.cmd == "pr":
        door = {"filter-get": "pr.filter.get", "filter-set": "pr.filter.set", "views": "pr.views.list", "view-save": "pr.views.save", "view-delete": "pr.views.delete"}[a.pverb]
        given = {"repo": a.repo}
        if a.pverb == "filter-set":
            if a.clear == (a.text is not None):
                print("agentglass-ui: pr filter-set takes the filter text, or --clear, not both and not neither", file=sys.stderr)
                return 2
            given.update({"clear": True} if a.clear else {"text": a.text})
        elif a.pverb in ("view-save", "view-delete"):
            given["name"] = a.name
            if a.pverb == "view-save" and a.text is not None:
                given["filter"] = a.text
        return emit(run_door(door, given, a.as_name))
    if a.cmd == "jira":
        given = {k: getattr(a, k) for k in JIRA_VERBS[a.jverb]["args"] if getattr(a, k, None) is not None}
        return emit(run_jira(a.jverb, given, a.as_name))
    if a.cmd in ("open", "stage"):
        kv, why = parse_kv(a.arg)
        if why:
            print(f"agentglass-ui: {why}", file=sys.stderr)
            return 2
        listing = fetch_actions()
        actions, level, bad = listing
        if bad:
            return emit({"ok": False, "error": bad})
        entry = next((x for x in actions if x["id"] == a.id), None)
        if entry is not None and entry["kind"] != a.cmd:
            verb = {"read": "`agentglass-ui state`, `read <panel>` or `settings get|list`", "change": "`agentglass-ui settings set`",
                    "open": "`agentglass-ui open`", "stage": "`agentglass-ui stage`"}.get(entry["kind"], "its own verb")
            return emit({"ok": False, "error": f"{a.id} is a {entry['kind']}, not {'an' if a.cmd == 'open' else 'a'} {a.cmd}: use {verb}"})
        typed = {}
        for k, text in kv.items():
            spec = (entry or {}).get("args", {}).get(k)
            if spec is None:
                typed[k] = text  # build_command names the unknown argument
                continue
            v, bad = coerce(spec, text)
            if bad:
                return emit({"ok": False, "error": f"{a.id}: {k} must be {bad}"})
            typed[k] = v
        present = "now" if a.now else "quiet" if a.quiet else None
        return emit(run_door(a.id, typed, a.as_name, listing, present))
    if a.cmd == "notify":
        if not 0 <= a.delay <= 60:
            print("agentglass-ui: notify test --in is 0 to 60 seconds", file=sys.stderr)
            return 2
        return emit(run_door("notify.test", {"kind": a.kind, "in": a.delay}, a.as_name))
    if a.cmd == "flight-plan":
        return emit(flight_plan(a.fverb, a, a.as_name))
    if a.cmd == "polaris":
        return emit(polaris(a.pverb2, {k: getattr(a, k) for k in POLARIS_VERBS[a.pverb2]["args"] if getattr(a, k, None) is not None}, a.as_name))
    if a.cmd == "rules":
        root = a.root or os.getcwd()
        if a.rverb == "set":
            return emit(rules_set(root, a.match, a.setting, a.as_name, a.action))
        return emit(rules_list(root, only_suggested=a.rverb == "suggest"))
    if a.cmd == "flow":
        if a.flverb == "get":
            return emit(flow_get(a.root))
        if a.flverb == "set":
            return emit(flow_set(a.root, a.file))
        if a.flverb == "undo":
            return emit(flow_undo(a.root))
        if a.flverb == "role":
            if a.frverb == "add":
                return emit(flow_role_add(a.root, a))
            if a.frverb == "rename":
                return emit(flow_role_rename(a.root, a.id, a.name))
            return emit(flow_role_edit(a.root, a.id, a))
        return emit(flow_path(a.root, a.fpverb, a.ids if a.fpverb == "set" else [a.id], getattr(a, "after", None)))
    if a.verb == "list":
        return emit(settings_list(a.as_name))
    if a.verb == "requests":
        return emit(settings_requests(a.as_name))
    if a.verb == "get":
        return emit(settings_get(a.id, a.as_name, a.root))
    # A value starting with "-" would be read as an option; "--" before it is the way.
    return emit(settings_set(a.id, a.value, a.as_name, a.root))


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (BrokenPipeError, KeyboardInterrupt):
        sys.exit(0)
