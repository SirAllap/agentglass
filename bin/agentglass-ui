    for verb, why in (("reviews", "who reviewed a pull request and what they said, read by the server (answer: {state, untrusted})"), ("comments", "the conversation and line comments of a pull request, read by the server (answer: {state, untrusted})")):
        q = ps.add_parser(verb, help=why)
