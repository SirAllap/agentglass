_JIRA_INT = ("updated", "pr_number", "start", "sprint")
_JIRA_BOOL = ("stay", "clear", "confirm", "off")


def jira_body(verb, given, as_name=None):
    """The POST /jira/door/<verb> body for typed or textual arguments: (body, None) or (None, one sentence).
    The server validates again; this is for the sentence a person can act on before a request is made."""
    spec = JIRA_VERBS.get(verb)
    if spec is None:
        return None, f"{verb} is not a card verb: {', '.join(JIRA_VERBS)}"
    unknown = sorted(set(given) - set(spec["args"]))
    if unknown:
        return None, f"{verb} takes {', '.join(spec['args']) or 'no arguments'}, not {', '.join(unknown)}"
    for k, (_why, required) in spec["args"].items():
        if required and given.get(k) in (None, ""):
            return None, f"{verb} needs {k} ({spec['args'][k][0]})"
    flat = {}
    for k, v in given.items():
        if k in _JIRA_INT:
            if isinstance(v, bool) or not (isinstance(v, int) or (isinstance(v, str) and re.fullmatch(r"\d+", v))):
                return None, f"{k} must be a whole number"
            v = int(v)
        elif k in _JIRA_BOOL:
            if isinstance(v, str):
                low = v.lower()
                if low not in ("true", "false"):
                    return None, f"{k} must be true or false"
                v = low == "true"
            elif not isinstance(v, bool):
                return None, f"{k} must be true or false"
        elif k == "keys":
            if not isinstance(v, str):
                return None, "keys must be text, comma separated"
            v = [x.strip() for x in v.split(",") if x.strip()]
        elif k == "fields":
            if isinstance(v, str):
                try:
                    v = json.loads(v)
                except ValueError:
                    return None, "fields must be a JSON object by field key"
            if not isinstance(v, dict):
                return None, "fields must be a JSON object by field key"
        elif not isinstance(v, str):
            return None, f"{k} must be text"
        flat[k] = v
    body = {k: flat[k] for k in ("key", "trigger", "updated", "url", "title", "field", "value", "add", "remove", "id", "text", "reply_to", "confirm", "off", "other", "type", "direction", "fields", "sprint") if k in flat}
    if verb == "sprint-move":
        body["keys"] = [flat["key"]] + [x for x in flat.get("keys", []) if x != flat["key"]]
    # `clear` is a step's choice on a step and a top-level word on an edit.
    if verb == "edit" and "clear" in flat:
        body["clear"] = flat["clear"]
    choice = {k: flat[k] for k in ("to", "stay", "clear", "assign", "comment") if k in flat and verb == "step"}
    pr = {k[3:]: flat[k] for k in ("pr_url", "pr_title", "pr_number", "pr_author") if k in flat}
    if choice:
        body["choice"] = choice
    if pr:
        body["pr"] = pr
    if as_name:
        body["as"] = as_name
    return body, None


PR_DOOR_VERBS = ("reviews", "comments")


def run_pr_read(verb, repo, number, as_name=None):
    """Who reviewed and what was said on a pull request, read by the server with its own gh: `{state, untrusted}`."""
    body = {"repo": repo, "number": number, **({"as": as_name} if as_name else {})}
    status, res = http(f"/pr/door/{verb}", body, timeout=60)
    if status == 404 and not res.get("error"):
        return {"ok": False, "error": "this agentglass is older than the pull request read door: update the app (it has no POST /pr/door)"}
    if not isinstance(res, dict) or "ok" not in res:
        return {"ok": False, "error": (res or {}).get("error") or f"agentglass answered {status}"}
    return res


def run_jira(verb, given, as_name=None):
    """One card verb, through the route the screen uses. The answer is the server's, `ok` and a sentence or the shape."""
    body, why = jira_body(verb, given, as_name)
    if why:
        return {"ok": False, "error": why}
    status, res = http(f"/jira/door/{verb}", body, timeout=30)
    if status == 404 and not res.get("error"):
        return {"ok": False, "error": "this agentglass is older than the Jira card door: update the app (it has no POST /jira/door)"}
    if not isinstance(res, dict) or "ok" not in res:
        return {"ok": False, "error": (res or {}).get("error") or f"agentglass answered {status}"}
    return res


# ── the command line ────────────────────────────────────────────────────────

def emit(res):
    print(json.dumps(res))
    return 0 if res.get("ok") else 1


# The freeze trace's read side. Local files, no server round trip: the point
# of the trace is to still be readable when the app itself is the thing that
# froze or crashed, so this never asks it for anything.
#
# electron/main.js writes window.log into Electron's userData, which is
# $XDG_CONFIG_HOME/<productName>; a few build variants exist, so every one is
# checked. loopwatch.ts writes server-stall.log into the state dir the server
# itself uses (childledger.ts' stateDir()).
_FREEZE_APP_NAMES = ("agentglass", "agentglass-release", "agentglass-local-review")


def _freeze_config_dirs():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return [os.path.join(base, name) for name in _FREEZE_APP_NAMES]


def _freeze_state_dir():
    base = os.environ.get("AGENTGLASS_STATE_DIR")
    if base:
        return base
    xdg = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(xdg, "agentglass")


def _tail(path, n):
    try:
        with open(path, "r", errors="replace") as f:
            return [ln.rstrip("\n") for ln in f if ln.strip()][-n:]
    except OSError:
        return []


def freezes(n=20):
    lines = []
    for d in _freeze_config_dirs():
        lines += _tail(os.path.join(d, "window.log"), n)
    lines += _tail(os.path.join(_freeze_state_dir(), "server-stall.log"), n)
    # Every line starts with an ISO timestamp (main.js, loopwatch.ts); sorting
    # on that interleaves the shell's and the server's lines in order.
    lines.sort(key=lambda ln: ln[:24])
    return {"ok": True, "lines": lines[-n:]}


def _list():
    actions, level, why = fetch_actions()
    if why:
        return {"ok": False, "error": why}
    return {"ok": True, "level": level, "actions": [
        {"id": a["id"], "level": a["level"], "kind": a["kind"], "surface": a["surface"],
         "args": {k: _describe(s) + ("" if not s.get("optional") and s.get("t") != "pathKind" else " (optional)")
                  for k, s in a["args"].items()}}
        for a in actions]}


def main(argv=None):
    ap = argparse.ArgumentParser(prog="agentglass-ui", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--as", dest="as_name", metavar="NAME", default=os.environ.get("AGENTGLASS_UI_AS") or None,
                    help="stamp the call with this name in the action log")
