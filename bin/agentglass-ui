                        "text": ("the file's words (or give data)", False), "data": ("the file's bytes as base64 (or give text)", False)}},
    "unattach": {"acting": True,
                 "surface": "take one of your own files off a card, by the `fileId` `card` listed for it; refused for a file the card does not hold or one somebody else added, below control level 3, when Jira writes are off, and unless confirm is true",
                 "args": {"key": ("a card id such as ORBIT-1042", True), "id": ("the file's id, from `card`", True), "confirm": ("true to say you mean it", True)}},
}
_JIRA_INT = ("updated", "pr_number", "start")
_JIRA_BOOL = ("stay", "clear", "confirm", "off")


def jira_body(verb, given, as_name=None):
    """The POST /jira/door/<verb> body for typed or textual arguments: (body, None) or (None, one sentence).
    The server validates again; this is for the sentence a person can act on before a request is made."""
    spec = JIRA_VERBS.get(verb)
    if spec is None:
        return None, f"{verb} is not a card verb: {', '.join(JIRA_VERBS)}"
    unknown = sorted(set(given) - set(spec["args"]))
    if unknown:
        return None, f"{verb} takes {', '.join(spec['args']) or 'no arguments'}, not {', '.join(unknown)}"
    for k, (_why, required) in spec["args"].items():
        if required and given.get(k) in (None, ""):
            return None, f"{verb} needs {k} ({spec['args'][k][0]})"
    flat = {}
    for k, v in given.items():
        if k in _JIRA_INT:
            if isinstance(v, bool) or not (isinstance(v, int) or (isinstance(v, str) and re.fullmatch(r"\d+", v))):
                return None, f"{k} must be a whole number"
            v = int(v)
        elif k in _JIRA_BOOL:
            if isinstance(v, str):
                low = v.lower()
                if low not in ("true", "false"):
                    return None, f"{k} must be true or false"
                v = low == "true"
            elif not isinstance(v, bool):
                return None, f"{k} must be true or false"
        elif k == "fields":
            if isinstance(v, str):
                try:
                    v = json.loads(v)
                except ValueError:
                    return None, "fields must be a JSON object by field key"
            if not isinstance(v, dict):
                return None, "fields must be a JSON object by field key"
        elif not isinstance(v, str):
            return None, f"{k} must be text"
        flat[k] = v
    body = {k: flat[k] for k in ("key", "trigger", "updated", "url", "title", "field", "value", "add", "remove", "id", "text", "reply_to", "confirm", "off", "other", "type", "direction", "fields") if k in flat}
    # `clear` is a step's choice on a step and a top-level word on an edit.
    if verb == "edit" and "clear" in flat:
        body["clear"] = flat["clear"]
    choice = {k: flat[k] for k in ("to", "stay", "clear", "assign", "comment") if k in flat and verb == "step"}
    pr = {k[3:]: flat[k] for k in ("pr_url", "pr_title", "pr_number", "pr_author") if k in flat}
    if choice:
        body["choice"] = choice
    if pr:
        body["pr"] = pr
    if as_name:
        body["as"] = as_name
    return body, None


def run_jira(verb, given, as_name=None):
    """One card verb, through the route the screen uses. The answer is the server's, `ok` and a sentence or the shape."""
    body, why = jira_body(verb, given, as_name)
    if why:
        return {"ok": False, "error": why}
    status, res = http(f"/jira/door/{verb}", body, timeout=30)
    if status == 404 and not res.get("error"):
        return {"ok": False, "error": "this agentglass is older than the Jira card door: update the app (it has no POST /jira/door)"}
    if not isinstance(res, dict) or "ok" not in res:
        return {"ok": False, "error": (res or {}).get("error") or f"agentglass answered {status}"}
    return res


# ── the command line ────────────────────────────────────────────────────────

def emit(res):
    print(json.dumps(res))
    return 0 if res.get("ok") else 1


def _list():
    actions, level, why = fetch_actions()
    if why:
        return {"ok": False, "error": why}
    return {"ok": True, "level": level, "actions": [
        {"id": a["id"], "level": a["level"], "kind": a["kind"], "surface": a["surface"],
         "args": {k: _describe(s) + ("" if not s.get("optional") and s.get("t") != "pathKind" else " (optional)")
                  for k, s in a["args"].items()}}
        for a in actions]}


def main(argv=None):
    ap = argparse.ArgumentParser(prog="agentglass-ui", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--as", dest="as_name", metavar="NAME", default=os.environ.get("AGENTGLASS_UI_AS") or None,
                    help="stamp the call with this name in the action log")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="the doors this app offers, with their arguments and levels")
    sub.add_parser("state", help="what is open now (ui.state)")
    p = sub.add_parser("read", help="one panel's state, shown nowhere (ui.read)")
    p.add_argument("panel")
    p = sub.add_parser("open", help="open something on screen, by registry id")
    p.add_argument("id")
    p.add_argument("--arg", "-a", action="append", default=[], metavar="NAME=VALUE")
    pm = p.add_mutually_exclusive_group()
    pm.add_argument("--now", action="store_true",
                    help="show it at once: ONLY when the person just asked you to show them this")
    pm.add_argument("--quiet", action="store_true",
                    help="never raise the window or take the keyboard; wait behind a chip if the person is typing (the default)")
    p = sub.add_parser("stage", help="prepare a dialog for the person to finish, by registry id (level 3): it opens filled in and sends nothing")
    p.add_argument("id")
    p.add_argument("--arg", "-a", action="append", default=[], metavar="NAME=VALUE")
    pm = p.add_mutually_exclusive_group()
    pm.add_argument("--now", action="store_true", help="open it at once: ONLY when the person just asked you to prepare this")
    pm.add_argument("--quiet", action="store_true", help="wait behind a chip if the person is typing (the default)")
    p = sub.add_parser("jira", help="a Jira card through the routes the screen uses: card, moves, links, linktypes, activity, steps, step, link, edit, comment, comment-edit, comment-delete, move, subtask, relate, unrelate, weblink, unweblink, worklog, worklog-edit, worklog-delete, watch, vote, rank, attach, unattach")
    js = p.add_subparsers(dest="jverb", required=True)
    for verb, spec in JIRA_VERBS.items():
        q = js.add_parser(verb, help=spec["surface"])
        for k, (why, required) in spec["args"].items():
            if k in _JIRA_BOOL:
                q.add_argument("--" + k.replace("_", "-"), dest=k, action="store_const", const=True, default=None, help=why)
            elif required and k in ("key", "trigger", "url"):
                q.add_argument(k, help=why)
            else:
                q.add_argument("--" + k.replace("_", "-"), dest=k, default=None, required=(required and k == "updated"), help=why)
    p = sub.add_parser("settings", help="list, read or change the settings an agent may touch")
    ss = p.add_subparsers(dest="verb", required=True)
    ss.add_parser("list", help="every setting, the window's and the server's, with its class; and the requests waiting for the person")
    ss.add_parser("requests", help="the changes you asked for that wait for the person")
    q = ss.add_parser("get")
    q.add_argument("id")
    q.add_argument("--root", default=None, help="the project, for a setting held per project (the chair, a project's policy)")
    q = ss.add_parser("set")
    q.add_argument("id")
    q.add_argument("--root", default=None, help="the project, for a setting held per project (the chair, a project's policy)")
    q.add_argument("value", help="true/false and numbers are read as such, unless the setting stores text (settings list says which); anything else is text")
    a = ap.parse_args(argv)

    if a.as_name and not NAME.match(a.as_name):
        print("agentglass-ui: --as is letters, digits and . _ : - (at most 64)", file=sys.stderr)
        return 2
    if a.cmd == "list":
        return emit(_list())
    if a.cmd == "state":
        return emit(run_door("ui.state", {}, a.as_name))
    if a.cmd == "read":
        return emit(run_door("ui.read", {"panel": a.panel}, a.as_name))
    if a.cmd == "jira":
        given = {k: getattr(a, k) for k in JIRA_VERBS[a.jverb]["args"] if getattr(a, k, None) is not None}
        return emit(run_jira(a.jverb, given, a.as_name))
    if a.cmd in ("open", "stage"):
        kv, why = parse_kv(a.arg)
        if why:
            print(f"agentglass-ui: {why}", file=sys.stderr)
            return 2
        listing = fetch_actions()
        actions, level, bad = listing
        if bad:
            return emit({"ok": False, "error": bad})
        entry = next((x for x in actions if x["id"] == a.id), None)
        if entry is not None and entry["kind"] != a.cmd:
            verb = {"read": "`agentglass-ui state`, `read <panel>` or `settings get|list`", "change": "`agentglass-ui settings set`",
                    "open": "`agentglass-ui open`", "stage": "`agentglass-ui stage`"}.get(entry["kind"], "its own verb")
            return emit({"ok": False, "error": f"{a.id} is a {entry['kind']}, not {'an' if a.cmd == 'open' else 'a'} {a.cmd}: use {verb}"})
        typed = {}
        for k, text in kv.items():
            spec = (entry or {}).get("args", {}).get(k)
            if spec is None:
                typed[k] = text  # build_command names the unknown argument
                continue
            v, bad = coerce(spec, text)
            if bad:
                return emit({"ok": False, "error": f"{a.id}: {k} must be {bad}"})
            typed[k] = v
        present = "now" if a.now else "quiet" if a.quiet else None
        return emit(run_door(a.id, typed, a.as_name, listing, present))
    if a.verb == "list":
        return emit(settings_list(a.as_name))
    if a.verb == "requests":
        return emit(settings_requests())
    if a.verb == "get":
        return emit(settings_get(a.id, a.as_name, a.root))
    # A value starting with "-" would be read as an option; "--" before it is the way.
    return emit(settings_set(a.id, a.value, a.as_name, a.root))


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (BrokenPipeError, KeyboardInterrupt):
        sys.exit(0)
