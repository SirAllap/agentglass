def run_flight(name, args):
    from types import SimpleNamespace as NS
    verb = name[len("ui_flight_plan_"):].replace("_", "-")
    if verb.startswith("plan-"):
        return run_flight_plan(verb[len("plan-"):], args)
    root = args.get("root") if isinstance(args.get("root"), str) else None
    a = NS(state=args.get("state"), root=root, id=args.get("id"), finding=args.get("finding"), action=args.get("action"), note=args.get("note"),
           files=[f for f in args.get("files") or [] if isinstance(f, str)], mockup=[m for m in args.get("mockups") or [] if isinstance(m, str)],
           pr=args.get("pr") if isinstance(args.get("pr"), int) else None, moment=args.get("moment") or "manual")
    if verb in ("show", "go", "no-go", "resolve") and not isinstance(a.id, str):
        return _wrap({"ok": False, "error": "id: a run id"})
    if verb == "run" and not a.files and not a.pr:
        return _wrap({"ok": False, "error": "files: at least one path, or pr"})
    return _wrap(UI.flight_plan(verb, a, AS))


def run_flight_plan(pverb, args):
    """The plan's own verbs, through the CLI's one code path."""
    from types import SimpleNamespace as NS
    s = lambda k: args.get(k) if isinstance(args.get(k), str) else None
    a = NS(pverb=pverb, id=s("id"), request=s("request"), title=s("title"), task=s("task"), size=s("size"), root=s("root"), state=s("state"), file=None, plan_md=s("plan_md"),
           visual=args.get("visual") if isinstance(args.get("visual"), bool) else None, paths=[p for p in args.get("paths") or [] if isinstance(p, str)],
           reason=s("reason"), question=s("question"), choice=[c for c in args.get("choices") or [] if isinstance(c, str)], answer=s("answer"),
           detail=s("detail"), recommend=args.get("recommended") if isinstance(args.get("recommended"), int) else None, line=s("line"),
           step=args.get("step") if isinstance(args.get("step"), int) else None, of=args.get("of") if isinstance(args.get("of"), int) else None)
    if pverb == "new" and not a.request:
        return _wrap({"ok": False, "error": "request: what should be built"})
    if pverb in ("show", "set", "mockup", "preflight", "go", "no-go", "launch", "ask", "answer", "report", "integrate-check") and not a.id:
        return _wrap({"ok": False, "error": "id: a flight plan id"})
    return _wrap(UI.flight_plan("plan", a, AS))


def run_rules(name, args):
    root = args.get("root") if isinstance(args.get("root"), str) else os.getcwd()
    if name == "ui_rules_set":
        if not isinstance(args.get("match"), str) or args.get("setting") not in ("allow", "ask", "never"):
            return _wrap({"ok": False, "error": "match: a tool pattern; setting: allow, ask or never"})
        return _wrap(UI.rules_set(root, args["match"], args["setting"], AS, args.get("action") if isinstance(args.get("action"), str) else None))
    return _wrap(UI.rules_list(root, only_suggested=name == "ui_rules_suggest"))


def jira_tools(level=3):
    """The card verbs (POST /jira/door/<verb>): fixed by the server's route and not by the registry, so they are
    listed from the one table the CLI keeps, and a test holds that table equal to the server's own list of verbs.
    The verbs that change the site are listed at control level 3 only, which is where the server runs them:
    below it a tool that can only answer 403 is a door that is not there."""
    tools = []
    for verb, spec in UI.JIRA_VERBS.items():
        if spec["acting"] and level < 3:
            continue
        props = {}
        for k, (why, _required) in spec["args"].items():
            if k in UI._JIRA_INT:
                props[k] = {"type": "integer", "minimum": 0, "description": why}
            elif k in UI._JIRA_BOOL:
                props[k] = {"type": "boolean", "description": why}
            elif k == "fields":
                props[k] = {"type": "object", "additionalProperties": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}, "description": why}
            elif k == "kind":
                props[k] = {"type": "string", "enum": ["history", "worklog", "comments"], "description": why}
            elif k == "trigger":
                props[k] = {"type": "string", "enum": ["handoff", "review", "merge"], "description": why}
            else:
                props[k] = {"type": "string", "description": why}
        required = [k for k, (_w, req) in spec["args"].items() if req]
        desc = spec["surface"][:1].upper() + spec["surface"][1:] + "."
        desc += (" Changes the Jira site, with no click from the person: only at control level 3 and with the owner's Jira write switch on; the answer is the screen's sentence when the switch is off."
                 if spec["acting"] else " Reads only. " + UNTRUSTED)
        tools.append({
            "name": "ui_jira_" + verb, "description": desc,
            "inputSchema": {"type": "object", "properties": props, "required": required, "additionalProperties": False},
            # A step can take the assignee off and move the card; a link only adds one.
            "annotations": {"readOnlyHint": not spec["acting"], "destructiveHint": verb in ("step", "comment-delete", "unrelate", "unweblink", "worklog-delete", "unattach"),
                            "idempotentHint": verb not in ("step", "comment", "comment-delete", "subtask", "move"), "openWorldHint": spec["acting"]},
        })
    return tools


def run_jira_tool(name, args):
    verb = name[len("ui_jira_"):]
    res = UI.run_jira(verb, dict(args) if isinstance(args, dict) else {}, AS)
    return {"content": [{"type": "text", "text": json.dumps(res)}], **({} if res.get("ok") else {"isError": True})}


def _registry():
    """(actions, level, None) from the app, reused for LIST_TTL; or (None, None, why)."""
    if _cache["actions"] is not None and time.time() - _cache["at"] < LIST_TTL:
        return _cache["actions"], _cache["level"], None
    actions, level, why = UI.fetch_actions()
    if why:
        return None, None, why
    _cache.update(at=time.time(), actions=actions, level=level)
    return actions, level, None


def _wrap(res):
    return {"content": [{"type": "text", "text": json.dumps(res)}], **({} if res.get("ok") else {"isError": True})}


def run(name, args):
    if isinstance(name, str) and name.startswith("ui_jira_") and name[len("ui_jira_"):] in UI.JIRA_VERBS:
        return run_jira_tool(name, args)
    given0 = dict(args) if isinstance(args, dict) else {}
    if name in ("ui_rules_list", "ui_rules_suggest", "ui_rules_set"):
        return run_rules(name, given0)
    if name in {t["name"] for t in FLIGHT_TOOLS}:
        return run_flight(name, given0)
    # The settings verbs reach the server's settings as well as the window's (agentglass-ui does the routing).
    if name == "ui_settings_list":
        return _wrap(UI.settings_list(AS))
    if name in ("ui_settings_get", "ui_settings_set") and isinstance(given0.get("id"), str) and UI._server_row(given0["id"]) is not None:
        root = given0.get("root") if isinstance(given0.get("root"), str) else None
        return _wrap(UI.settings_get(given0["id"], AS, root) if name == "ui_settings_get" else UI.settings_set(given0["id"], given0.get("value"), AS, root))
    given0.pop("root", None)
    args = given0
    actions, level, why = _registry()
    if why:
        return {"content": [{"type": "text", "text": why}], "isError": True}
    entry = next((a for a in actions if tool_name(a["id"]) == name), None) if isinstance(name, str) else None
    if entry is None:
        return {"content": [{"type": "text", "text": f"no tool {name!r}; this server has "
                             + ", ".join(sorted(tool_name(a["id"]) for a in actions))}], "isError": True}
    given = dict(args) if isinstance(args, dict) else {}
    present = None
    if entry["kind"] in ("open", "stage"):
        now = given.pop(NOW, None)
        if now is not None and not isinstance(now, bool):
            return {"content": [{"type": "text", "text": "now is true or false"}], "isError": True}
        present = "now" if now else None
    given = UI.typed_given(entry["id"], given, AS, (actions, level, None))
    cmd, bad = UI.build_command(actions, level, entry["id"], given, AS, present=present)
    if bad:
        return {"content": [{"type": "text", "text": bad}], "isError": True}
    status, body = UI.http("/control", cmd, timeout=20)
    res = UI.explain(status, body, entry["id"])
    return {"content": [{"type": "text", "text": json.dumps(res)}], **({} if res.get("ok") else {"isError": True})}


def handle_message(msg):
    # A line that parses to a list, a string or a number is not a message.
    if not isinstance(msg, dict):
        return None
    method = msg.get("method")
    msg_id = msg.get("id")
    if msg_id is None:
        return None
    if method == "initialize":
        return T.make_reply(msg_id, {
            "protocolVersion": T.PROTOCOL,
            "capabilities": {"tools": {}},
            "serverInfo": {"name": NAME, "version": VERSION},
            "instructions": (
                "The agentglass window's own screen: open a panel, read what is open, read and change a setting the "
                "app exposes. Reads (ui_state, ui_read, ui_settings_get, ui_settings_list) show nothing; opens are quiet "
                "and wait behind a chip while the person types (now=true only when they just asked to be shown). "
                "A stage tool (level 3, when the owner allows it) only prepares a dialog filled in with what you wrote, for the person to read, edit and press themselves: nothing is merged, posted, submitted or moved by you. "
                + "ui_jira_card, ui_jira_moves, ui_jira_links, ui_jira_linktypes, ui_jira_activity and ui_jira_steps read a Jira card; ui_jira_step, ui_jira_link, ui_jira_edit, ui_jira_comment, ui_jira_comment-edit, ui_jira_comment-delete, ui_jira_move, ui_jira_subtask, ui_jira_relate, ui_jira_unrelate, ui_jira_weblink, ui_jira_unweblink, ui_jira_worklog, ui_jira_worklog-edit, ui_jira_worklog-delete, ui_jira_watch, ui_jira_vote, ui_jira_rank, ui_jira_attach and ui_jira_unattach change it, only on a server at control level 3 where the owner has also switched Jira writes on; below that level they are not listed, and with the switch off they answer with the screen's own sentence. "
                + UNTRUSTED + " Never set a secret. To undo a change, set the setting back to `prev`."),
        })
    if method == "tools/list":
        actions, level, why = _registry()
        if why:
            return T.make_reply(msg_id, error={"code": -32603, "message": why})
        return T.make_reply(msg_id, {"tools": tools_from_actions(actions) + jira_tools(level) + RULES_TOOLS + FLIGHT_TOOLS})
    if method == "tools/call":
        params = msg.get("params")
        if not isinstance(params, dict):
            return T.make_reply(msg_id, error={"code": -32602, "message": "params is an object with a name"})
        return T.make_reply(msg_id, run(params.get("name", ""), params.get("arguments") or {}))
    if method == "ping":
        return T.make_reply(msg_id, {})
    return T.make_reply(msg_id, error={"code": -32601, "message": f"method not found: {method}"})


def main(argv=None):
    import argparse
    ap = argparse.ArgumentParser(prog="agentglass-ui-mcp", add_help=False)
    ap.add_argument("--http", metavar="[HOST:]PORT")
    ap.add_argument("--expose", action="store_true")
    ap.add_argument("--allow-host", action="append", default=[], metavar="NAME")
    args, _ = ap.parse_known_args(argv)
    bind = args.http or os.environ.get("AGENTGLASS_UI_MCP_HTTP")
    if bind:
        allow = list(args.allow_host) + os.environ.get("AGENTGLASS_UI_MCP_ALLOW_HOSTS", "").split(",")
        return T._run_http(bind, expose=args.expose, allow_hosts=allow, handle=handle_message, name=NAME,
                           token_env="AGENTGLASS_UI_MCP_TOKEN",
                           distinct_from=("AGENTGLASS_TOKEN", "AGENTGLASS_MCP_TOKEN", "AGENTGLASS_COCKPIT_TOKEN", "AGENTGLASS_FLIGHTPLAN_MCP_TOKEN"),
                           opens="the app's own screen: panels and settings", expose_env="AGENTGLASS_UI_MCP_EXPOSE")
    return T._serve_stdio(handle_message)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (BrokenPipeError, KeyboardInterrupt):
        sys.exit(0)
