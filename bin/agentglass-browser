    p.add_argument("selector")
    p = sub.add_parser("coverage",
                       help="which JS and CSS actually RAN — the direct answer to 'did my change even load'")
    p.add_argument("action", nargs="?", choices=["start", "stop"], default="start")
    p = sub.add_parser("trace", help="DevTools trace — DOM, network and console against one timeline")
    p.add_argument("action", nargs="?", choices=["start", "stop"], default="start")
    p.add_argument("path", nargs="?", help="path to save the trace to (required for stop)")
    p = sub.add_parser(
        "do",
        help="several verbs in ONE call — starting this process costs ~104ms, so six "
             "verbs is most of a second spent before touching the page",
        description="Steps run in order and stop at the first failure, which keeps its "
                    "own diagnosis. Two forms:\n"
                    "  do 'click #save' 'wait #done' --observe\n"
                    "  do --steps-file steps.json      (a JSON list of {op, args})",
    )
    p.add_argument("step", nargs="*",
                   help="a verb and its first argument, quoted: 'click #save'")
    p.add_argument("--steps-file", help="JSON list of {op, args} — for anything the short form cannot say")
    p.add_argument("--observe", action="store_true",
                   help="append the observation after the last step, so the batch answers "
                        "'what does the page look like now' without another call")
    # ── THE SAME FLAGS AFTER THE VERB, TOO ──────────────────────────────────
    #
    # argparse only sees a global flag BEFORE the subcommand, and nobody writes
    # it there: `open --as review https://…` is how every example in the skill
    # reads and how an agent will type it. Added to each verb as well, with
    # SUPPRESS so that a verb which does NOT carry one leaves the global answer
    # alone instead of resetting it to None.
    #
    # `settings` keeps its own `--internal-page`; `--page` here would be a
    # second meaning for one word.
    def add_global(sp, *names, **kw):
        """Add one global flag to a verb, unless that verb already has it.

        `shot` has its own `--out`, `observe` its own `--shot`/`--observe`:
        a second one collides on the parser and the whole tool stops starting.

        THE TWO `SUPPRESS`ES WERE NOT THE SAME SUPPRESS, and only one of them
        had a job. `default=argparse.SUPPRESS` is load-bearing — it is what
        stops a verb that does not carry the flag from resetting the global
        answer to `None` (see the comment above). `help=argparse.SUPPRESS`
        carried no duty at all, and it cost an hour of somebody's work once:
        two names for one thing, "an agent that learned one checked the other's
        help, did not find it, and reasonably concluded the second could not
        take an identity" — then used a bare `open` and landed in the wrong
        cookie jar. `agentglass-browser open --help` printed four lines and
        none of them was `--as`.
        """
        if any(n in (act.option_strings or []) for act in sp._actions for n in names):
            return
        sp.add_argument(*names, default=argparse.SUPPRESS, **kw)

    for name, sp in sub.choices.items():
        add_global(sp, "--as", "--profile", dest="asProfile", metavar="NAME",
                   help="work as this identity — its own cookies, storage and tabs")
        add_global(sp, "--shared", action="store_true",
                   help="work in the person's own container (the default profile)")
        add_global(sp, "--active", action="store_true",
                   help="act on whichever tab is in front, whoever owns it")
        if name != "settings":
            # `settings` has an argument of its own called `page` — the internal
            # page a webview renders, where "blank" is the only allowed value —
            # so a second meaning for the word here would make every
            # `settings set --page t17-...` answer `page must be "blank"`.
            add_global(sp, "--page", metavar="TAB",
                       help="act on this tab instead of your own (see `tabs`)")
        add_global(sp, "--max-tokens", dest="maxTokens", type=int,
                   help="truncate the answer to roughly this many tokens, keeping what matters first")
        add_global(sp, "--observe", action="store_true",
                   help="hand back the page this left behind, under `after`")
        add_global(sp, "--summary", action="store_true",
                   help="print one line describing the answer")
        add_global(sp, "--show", action="store_true",
                   help="bring the browser view to the front: a tab this opens takes the pane, "
                        "and a hidden pane is opened and the call retried")
        add_global(sp, "--no-show", action="store_false", dest="show",
                   help="the opposite, for a shell that has AGENTGLASS_BROWSER_SHOW=1")
        add_global(sp, "--out", dest="outFile",
                   help="write the full answer here instead of stdout")

    a = ap.parse_args()

    # ── WHO IS ASKING, RESOLVED BEFORE ANY VERB CAN RETURN ──────────────────
    #
    # This used to live four hundred lines down, past the four verbs that
    # answer and return — `session`, `permissions`, `cdp`, `do` — so for those
    # four `--as NAME` was parsed and thrown away. The `do` half of the
    # incident is exactly that: sixty-three batches went out bare while the
    # same script's single-verb calls all carried `page: t4-39xgg3`.
    #
    # It is not the first thing to be caught out by those early returns.
    # `--out`/`--max-tokens` "lived at the bottom of main() and the verbs that
    # return EARLY — cdp, do — never reached it"; that was fixed by extracting
    # `emit`. Identity was not moved with it. It is moved now, and everything
    # below reads THESE variables rather than computing its own answer.
    who = acting_as(a)
    # `--shared` is an identity (the person's container) but NOT a profile
    # name: the panel mints a container for any name it does not know, and the
    # person's session is the EMPTY profile field. So it is remembered like an
    # identity and sent like nobody. See SHARED_KEY.
    named_profile = who and who != SHARED_KEY
    # Whose `--since-last` floor this is. Not the same question as which tab to
    # act on: `--active` has no identity to target with and still has a reader.
    cursor = cursor_key(a)
    if getattr(a, "shared", False) and getattr(a, "active", False):
        print("--shared and --active mean different tabs — pass one", file=sys.stderr)
        return 2

    if a.cmd == "session":
        # Addressed like everything else. `session save` reads cookies AND
        # localStorage, so an unaddressed one hands over another container's
        # login — the single most valuable thing a hijacked tab holds.
        page, refusal = addressed(a, "session")
        if refusal:
            print(refusal, file=sys.stderr)
            return 1
        return session_save(a.file, page, a) if a.sessionCmd == "save" else session_load(a.file, page, a)

    if a.cmd == "permissions":
        page, refusal = addressed(a, "permissions")
        if refusal:
            print(refusal, file=sys.stderr)
            return 1
        r = call("cdp", stamped(a, _at(page, {"method": "Browser.grantPermissions",
                                   "params": {"origin": a.origin, "permissions": a.grant}})))
        if not r.get("ok"):
            print(r.get("error") or "could not grant those permissions", file=sys.stderr)
            return 1
        print(f"granted {', '.join(a.grant)} to {a.origin}")
        return 0

    if a.cmd == "cdp":
        page, refusal = addressed(a, "cdp")
        if refusal:
            print(refusal, file=sys.stderr)
            return 1
        if a.events:
            body = {"events": True}
        elif not a.method:
            print("cdp needs a method, or --events", file=sys.stderr)
            return 2
        else:
            body = {"method": a.method}
            if a.params:
                try:
                    body["params"] = json.loads(a.params)
                except ValueError as e:
                    print(f"--params must be JSON: {e}", file=sys.stderr)
                    return 2
        res = call("cdp", stamped(a, _at(page, body)))
        if not res.get("ok"):
            print(res.get("error") or "the DevTools protocol refused that", file=sys.stderr)
            print_diagnosis(res.get("diagnosis"))
            return 1
        # The clone's run found this and fixed it inline here; `emit` is the
        # same fix moved somewhere it cannot be missed twice — `do` returns
        # early as well, and the next verb that does will get it for free.
        return emit("cdp", res.get("value") or {}, a)

    if a.cmd == "do":
        # A READ-ONLY BATCH IS THE DANGEROUS ONE. `do "read" "text body"` has
        # no leading `open` to overwrite the page, so on an unaddressed call it
        # returns the other container's page verbatim into this transcript.
        page, refusal = addressed(a, "do")
        if refusal:
            print(refusal, file=sys.stderr)
            return 1
        steps = do_steps(a)
        if steps is None:
            return 2
        # `_at` on the outer body AND `steps_at` on the steps. Only the second
        # one reaches the browser — `runSteps` never reads the outer `page`,
        # see `steps_at` — but the two address forms this endpoint accepts
        # (`{steps}` and `{lanes:[{page, steps}]}`) both put the tab on the
        # request, and a batch whose body does not say which tab it is for
        # reads as un-addressed to anything that logs it.
        res = call("do", stamped(a, _at(page, {"steps": steps_at(steps, page), "observe": a.observe})))
        for i, st in enumerate(res.get("steps") or []):
            if st.get("ok"):
                v = st.get("value")
                print(f"{i + 1}. {st.get('op')}: {json.dumps(v) if v is not None else 'ok'}")
            else:
                print(f"{i + 1}. {st.get('op')}: {st.get('error') or 'failed'}", file=sys.stderr)
                print_diagnosis(st.get("diagnosis"))
        return 0 if res.get("ok") else 1

    if a.cmd in ("dblclick", "rightclick", "hover", "focus", "blur"):
        body = {"selector": a.selector}
    elif a.cmd == "check":
        body = {"selector": a.selector, "checked": not a.off}
    elif a.cmd == "fill":
        fields = {}
        for pair in a.field:
            if "=" not in pair:
                print(f"--field takes SELECTOR=VALUE, got {pair!r}", file=sys.stderr)
                return 2
            k, v = pair.split("=", 1)
            fields[k] = v
        if not fields:
            print("fill needs at least one --field SELECTOR=VALUE", file=sys.stderr)
            return 2
        body = {"fields": fields, "submit": a.submit}
    elif a.cmd == "emulate":
        body = {}
        for flag, key in (("width", "width"), ("height", "height"), ("scale", "scale"),
                          ("user_agent", "userAgent"), ("language", "language"),
                          ("timezone", "timezone"), ("locale", "locale"), ("color_scheme", "colorScheme"),
                          ("reduced_motion", "reducedMotion"), ("vision", "vision")):
            v = getattr(a, flag, None)
            if v is not None:
                body[key] = v
        if a.mobile:
            body["mobile"] = True
        if a.reset:
            body["reset"] = True
        if a.geo:
            try:
                lat, lon = (float(x) for x in a.geo.split(",", 1))
            except ValueError:
                print("--geo takes lat,lon", file=sys.stderr)
                return 2
            body["geolocation"] = {"lat": lat, "lon": lon}
    elif a.cmd == "clock":
        body = {}
        if a.advance_ms is not None:
            body["advanceMs"] = a.advance_ms
        if a.wait_for:
            body["waitFor"] = a.wait_for
        if a.seal:
            body["seal"] = True
        if a.freeze_animations:
            body["freezeAnimations"] = True
        if not body:
            print("clock needs something to do — --advance-ms, --seal, or --freeze-animations", file=sys.stderr)
            return 2
    elif a.cmd == "settings":
        body = {"action": a.action}
        if a.action == "set":
            if a.cache:
                body["cache"] = a.cache
            if a.ignoreCertErrors is not None:
                body["ignoreCertErrors"] = a.ignoreCertErrors == "true"
            if a.block_origin:
                block = {"origin": a.block_origin}
                if a.block_images is not None:
                    block["images"] = a.block_images == "true"
                if a.block_js is not None:
                    block["js"] = a.block_js == "true"
                body["block"] = block
            elif a.block_images is not None or a.block_js is not None:
                print("--block-images/--block-js need --block-origin", file=sys.stderr)
                return 2
            if a.internalPage:
                body["page"] = a.internalPage
    elif a.cmd in ("newtab", "open"):
        # Both verbs, one meaning. They took different flag names — `newtab
        # --profile` and `open --as` — for the same thing, and an agent that
        # learned one checked the other's help, did not find it, and reasonably
        # concluded the second could not take an identity. It then used a bare
        # `open` to resume after a restart, which is the shared profile. A
        # naming difference is not worth an hour of somebody's work in the
        # wrong cookie jar.
        body = {"url": a.url}
    elif a.cmd == "listeners":
        body = {"selector": a.selector}
    elif a.cmd == "coverage":
        body = {"action": a.action}
    elif a.cmd == "trace":
        body = {"action": a.action}
        if a.action == "stop" and a.path:
            body["path"] = a.path
    else:
        body = {}
    if a.cmd == "observe":
        body = {}
        if a.since is not None:
            body["since"] = a.since
        elif a.sinceLast:
            body["since"] = load_since(cursor, "observe")
        if a.shot:
            body["shot"] = True
    elif a.cmd in ("tab", "closetab"):
        # An index if it looks like one, an id otherwise. `tabs` prints both,
        # so either is a thing the caller has in front of it.
        body = {"index": int(a.which)} if a.which.isdigit() else {"id": a.which}
    elif a.cmd in ("console", "network"):
        body = {}
        if a.since is not None:
            body["since"] = a.since
        elif a.sinceLast:
            body["since"] = load_since(cursor, a.cmd)
        if a.limit is not None:
            body["limit"] = a.limit
    elif a.cmd == "eval":
        if a.file:
            try:
                with open(a.file) as f:
                    a.js = f.read()
            except OSError as e:
                print(f"could not read {a.file}: {e}", file=sys.stderr)
                return 2
        if not a.js:
            print("eval needs an expression, or --file", file=sys.stderr)
            return 2
        body = {"js": a.js, "await": a.await_}
        if a.max is not None:
            body["max"] = a.max
    elif a.cmd == "addInitScript":
        body = {"name": a.name, "js": a.js}
    elif a.cmd == "expose":
        body = {"name": a.name}
    elif a.cmd == "exposed":
        body = {}
        if a.since is not None:
            body["since"] = a.since
        elif a.sinceLast:
            body["since"] = load_since(cursor, "exposed")
        if a.limit is not None:
            body["limit"] = a.limit
    elif a.cmd == "select":
        body = {"selector": a.selector, "value": a.value}
    # THREE VERBS THAT DECLARED THEIR ARGUMENTS AND SENT NONE OF THEM.
    #
    # `drag`, `region` and `upload` each take a positional and none of them had
    # a branch here, so the body went out empty and the server refused with
    # "drag needs a selector for what to drag" — for a command that had just
    # been given one. Found by running them against a page built to answer:
    # every one of the three failed before it ever reached the browser.
    #
    # Same family as `shot --out`, `record`, `--page` and `cdp --out`: a flag
    # or an argument declared on one side of the wire and read on neither. The
    # lock for it is in server/test/cli-writes-files.test.ts — a verb is only
    # wired when something EXERCISES it.
    elif a.cmd == "drag":
        body = {"selector": a.selector, "to": a.to}
    # SEVEN VERBS WHOSE FLAGS WERE PARSED AND NEVER SENT.
    #
    # Same family as `drag`, `region`, `upload` and `profiles` before them: the
    # parser declares them, the body goes out empty, and the server refuses
    # with a sentence about the request it received rather than the one that
    # was typed — or, worse, treats the empty body as "clear everything".
    # Measured: `headers --set X-Agx-Probe=4417` answered {"headers": [],
    # "count": 0} and the probe server never saw the header;
    # `throttle --network slow-3g` answered "throttle needs network, cpu,
    # offline: true, or off: true" and a 400 KB fetch took 131ms before and
    # 139ms after.
    elif a.cmd == "headers":
        body = {}
        if a.set:
            pairs = {}
            for one in a.set:
                if "=" not in one:
                    print(f"--set takes NAME=VALUE, got {one}", file=sys.stderr)
                    return 2
                k, v = one.split("=", 1)
                pairs[k.strip()] = v
            body["headers"] = pairs
        # No --set at all is "clear them", which is what the empty body means
        # and the one case that was accidentally right.
    elif a.cmd == "throttle":
        body = {}
        if a.off:
            body["off"] = True
        elif a.offline:
            body["offline"] = True
        else:
            if a.network:
                body["network"] = a.network
            if a.cpu is not None:
                body["cpu"] = a.cpu
    elif a.cmd == "clipboard":
        body = {} if a.write is None else {"write": a.write}
    elif a.cmd == "storage":
        body = {"where": a.where}
        if a.set is not None:
            if "=" not in a.set:
                print("--set takes KEY=VALUE", file=sys.stderr)
                return 2
            k, v = a.set.split("=", 1)
            body["set"] = True
            body["key"] = k
            body["value"] = v
        elif a.remove is not None:
            body["remove"] = True
            body["key"] = a.remove
    elif a.cmd == "events":
        body = {"wait": a.wait}
        if a.since is not None:
            body["since"] = a.since
        if a.kind:
            body["kinds"] = a.kind
    elif a.cmd == "audit":
        body = {"script": True} if a.script else {}
        if a.by:
            body["by"] = a.by
    elif a.cmd == "debug":
        body = {"action": a.action}
        if a.action == "break":
            body["url"] = a.url
            body["line"] = a.line
            if a.condition is not None:
                body["condition"] = a.condition
        elif a.action == "dom":
            body["selector"] = a.selector
            body["on"] = a.on
    elif a.cmd == "intercept":
        body = {"pattern": a.pattern}
        if a.clear:
            body["clear"] = True
        elif a.fulfill:
            body["fulfill"] = True
            if a.status is not None:
                body["status"] = a.status
            if a.body is not None:
                body["body"] = a.body
        elif a.abort:
            body["abort"] = True
            if a.reason is not None:
                body["reason"] = a.reason
    elif a.cmd == "whoami":
        # No page, no selector, nothing to validate: the whole request is who
        # this shell is, and the answer is composed by the relay out of the tab
        # list. `identity`/`tab` are stamped below with every other verb's.
        body = {}
    elif a.cmd == "profiles":
        # THE FLAGS WERE DECLARED AND NEVER SENT. `--make` and `--drop` parsed
        # fine, the body went out empty, and the panel answered a plain list —
        # so `profiles --drop mine` looked like it had worked and left the
        # container, its cookies and its tabs exactly where they were. Measured
        # by a peer session: 31 containers dropped one by one, 41 still listed.
        body = {}
        if getattr(a, "make", None):
            body["make"] = a.make
        if getattr(a, "drop", None):
            body["drop"] = a.drop
        if getattr(a, "force", False):
            body["force"] = True
    elif a.cmd == "region":
        body = {"selector": a.selector}
    elif a.cmd == "upload":
        body = {"selector": a.selector, "paths": a.paths}
    elif a.cmd == "permission":
        body = {"origin": a.origin, "permissions": a.permissions}
    elif a.cmd == "reload":
        body = {"bypassCache": not a.keepCache}
    elif a.cmd == "cookies":
        body = {"set": {"name": a.set[0], "value": a.set[1], "path": a.path}} if a.set else {}
    elif a.cmd == "frames":
        body = {}
    elif a.cmd == "resize":
        body = {"width": a.width, "height": a.height}
    elif a.cmd == "zoom":
        body = {} if a.factor is None else {"factor": a.factor}
    elif a.cmd == "html":
        body = {"selector": a.selector}
        if a.max is not None:
            body["max"] = a.max
    elif a.cmd == "waitfor":
        if not a.js and not a.until:
            print("waitfor needs an expression, or --until network-idle|no-timers", file=sys.stderr)
            return 2
        body = {}
        if a.until:
            body["until"] = a.until
        if a.js:
            body["js"] = a.js
        if a.timeoutMs is not None:
            body["timeoutMs"] = a.timeoutMs
    elif a.cmd == "shot":
        body = {}
        if a.selector:
            body["selector"] = a.selector
        if a.clip:
            parts = a.clip.split(",")
            if len(parts) != 4 or not all(p.strip().lstrip("-").isdigit() for p in parts):
                print("--clip wants x,y,w,h — four whole numbers", file=sys.stderr)
                return 1
            x, y, w, h = (int(p) for p in parts)
            body["clip"] = {"x": x, "y": y, "width": w, "height": h}
        if a.highlight:
            body["highlight"] = a.highlight
        if a.label:
            if not a.highlight:
                print("--label needs --highlight — it captions the box, not the whole picture", file=sys.stderr)
                return 1
            body["label"] = a.label
        if a.omitBackground:
            body["omitBackground"] = True
    elif a.cmd in ("click", "wait"):
        body = {"selector": a.selector}
    elif a.cmd == "type":
        body = {"selector": a.selector, "text": a.text, "submit": a.submit}
    elif a.cmd == "text":
        body = {"selector": a.selector}
    elif a.cmd == "scroll":
        if a.selector:
            body = {"selector": a.selector}
        elif a.by is not None:
            body = {"by": a.by}
        else:
            body = {"to": a.to}
    elif a.cmd == "press":
        body = {"key": a.key}
    elif a.cmd == "record":
        # There was no branch here at all, so `dir` — a POSITIONAL argument, the
        # one thing this verb cannot work without — was parsed and then never
        # sent. The server refused every call with "dir must be an absolute
        # path", which is true of the request it received and impossible to act
        # on from outside: the path on the command line was absolute, and
        # existed. Measured: `record /tmp/test-record --frames 3` failed with a
        # trivially valid path, with and without --gif.
        body = {"dir": a.dir, "frames": a.frames, "every": a.every}
        if a.gif:
            body["gif"] = a.gif
        if a.selector:
            body["selector"] = a.selector
    elif a.cmd == "download":
        body = {"selector": a.selector, "dir": a.dir}
        if a.timeoutMs is not None:
            body["timeoutMs"] = a.timeoutMs
    elif a.cmd == "fake":
        if a.clear:
            body = {"pattern": a.pattern, "clear": True}
        else:
            if a.status is None and not a.timeout:
                print("fake needs --status N or --timeout (or --clear)", file=sys.stderr)
                return 2
            body = {"pattern": a.pattern}
            if a.timeout:
                body["timeout"] = True
            else:
                body["status"] = a.status
            if a.body is not None:
                body["body"] = a.body
            if a.delayMs is not None:
                body["delayMs"] = a.delayMs

    # `who` and `named_profile` were resolved at the top of main(), before the
    # first verb could return. Nothing recomputes them here.

    # §11/§13: WHO IS ASKING, said on the wire for the verbs whose ANSWER is
    # about ownership.
    #
    # The relay cannot derive this — the name comes from THIS process's
    # environment, which the server has never seen — so the two questions it
    # answers ("is this container mine", "may I drop it") have to be told. It
    # is an assertion and the relay treats it as one: what it checks is the
    # half it can, whether the tab this identity claims is still in the
    # window's list.
    #
    # Lost once, at the merge of two lanes that both rewrote this spot, and
    # caught by `whoami` answering `identity: null` — which is a pre-flight
    # that cannot answer the question it exists for.
    if who and a.cmd in ("whoami", "profiles", "open", "newtab"):
        body["identity"] = who
    if who and a.cmd in ("whoami", "profiles"):
        held = my_tab(who)
        if held:
            body["tab"] = held

    if a.cmd in ("newtab", "open") and who:
        mine = my_tab(who)
        # NAMING A TAB IS THE WHOLE ANSWER. `--page t63 open <url>` set the
        # identity's `profile` here, and the panel routes an `open` that
        # carries a profile to "make a tab in that container" — so it minted a
        # NEW tab, left the one that was named exactly where it was, and
        # answered with the URL and title of the tab it had just made. The
        # caller reads that as success. Measured: t63 stayed on
        # chrome-error://chromewebdata while the answer said "log probe".
        # `newtab` is untouched: it always makes one, so a page to go to is
        # not a thing it can be asked for.
        if a.cmd == "open" and getattr(a, "page", None):
            pass
        elif a.cmd == "open" and mine:
            # Already have one: GO there, do not make another. An agent that
            # calls `open` fifty times in a session means fifty pages, not
            # fifty tabs — and fifty tabs is how a browser runs out of room
            # holding the same page over and over.
            body["page"] = mine
        elif named_profile:
            body["profile"] = who
        else:
            # THE EMPTY STRING IS A NAME. That is what makes `--shared` work.
            #
            # This used to send NOTHING for the person's own container, on the
            # reasoning that the empty profile field IS that container. True of
            # the field, false of the ROUTE: the panel sends an `open` to the
            # minting path only when it carries a profile that is a string
            # (`browserBus.ts`, `typeof ask.args.profile === "string"`), and a
            # bare `open` instead calls `loadURL` on the mounted webview —
            # whichever tab is in front, whoever owns it — and answers without
            # an id. So nothing was ever remembered, every later `--shared`
            # verb was refused for having no tab, and the refusal's own first
            # remedy was the call that drives another agent's page. Measured
            # end to end against the real routing rule before this line.
            #
            # `""` is a string, so it routes to minting; and `addTab` passes it
            # through with `??`, which only falls through on null — so the tab
            # is born in the person's own partition, which is where it belongs.
            body["profile"] = ""

    if getattr(a, "observe", False):
        body["observe"] = True
    # `--page <tab id>` — six verbs declare it and exactly one was sending it,
    # so `shot --page t2-abc` quietly photographed the ACTIVE tab instead. The
    # server has accepted `page` on every acting verb all along; nothing was
    # putting it in the request. Set here rather than in each branch so the
    # seventh verb to declare it cannot repeat this.
    # ...EXCEPT for `settings`, whose `page` is not a tab.
    #
    # `settings` has an argument of its own called `page` — the internal page a
    # webview may render, and "blank" is the only allowed value. Putting a tab
    # id there made every `settings set --page t17-... --cache bypass` answer
    # `page must be "blank"`, which is a sentence about an argument the caller
    # never passed. The verb applies to the window's session, not to one tab,
    # so it has no use for the id at all.
    if getattr(a, "page", None) and "page" not in body and a.cmd != "settings":
        body["page"] = a.page
    # ...AND NEVER on the two pre-flight verbs. `--page` is a global, so
    # `agentglass-browser --page t17 whoami` parses; sending it would ask a
    # question about the list while naming one page, which the relay refuses.
    # Better to answer the question that was actually asked.
    if a.cmd in ("whoami", "profiles"):
        body.pop("page", None)

    # ── EVERY VERB GOES TO YOUR OWN TAB ─────────────────────────────────────
    #
    # Not "the active tab", which is whatever the person or the last agent left
    # in front. That default is right for somebody clicking around and wrong for
    # every agent that has ever used this: it is how two agents end up typing
    # into each other's page, and how a screenshot comes back showing somebody
    # else's work.
    #
    # `--page` still wins — sometimes you really do mean another tab — and the
    # tab verbs are about the LIST rather than a page inside one, so they are
    # left alone. So is `settings`, whose `page` means something else entirely.
    # §11: `profiles` and `whoami` are about the LIST and about who is holding
    # the screen — never about a page inside a tab. They are in here so they are
    # not auto-addressed at this identity's tab, and `page` is stripped from
    # them below so a stray global `--page` cannot address them either.
    TAB_OPS = {"tabs", "tab", "newtab", "closetab", "profiles", "whoami", "health", "settings"}
    # `open` under `--shared` carries neither a page nor a profile ON PURPOSE:
    # the person's own container IS the empty profile field, so "make me a tab
    # there" is a request with nothing on it. That is the one shape that looks
    # un-addressed and is not, and it has to be exempted by hand or `--shared`
    # loses the only way it has of getting a tab — a refusal nobody can answer
    # is a refusal that gets worked around.
    # `open --shared` now carries `profile: ""`, so it is addressed like any
    # other minting request and needs no exemption of its own. Kept as a name
    # rather than deleted, because the branch below reads better saying WHY it
    # is not refusing than saying nothing.
    minting_shared = a.cmd == "open" and "profile" in body
    if a.cmd not in TAB_OPS and "page" not in body:
        mine = my_tab(who)
        if mine:
            body["page"] = mine
        elif who and "profile" not in body:
            # AN IDENTITY WITH NO TAB REFUSES. IT DOES NOT FALL THROUGH.
            #
            # `profile` is the other way a request can be addressed, and the
            # one `open`/`newtab` use: "make me a tab in this container" is
            # perfectly targeted, and refusing it would leave an identity with
            # no tab no way to get one — a refusal you cannot answer, which is
            # how a guard gets worked around with `--shared` on everything.
            # Caught by the CLI suite the moment this was written the other
            # way: twenty tests, every one of which opens before it acts.
            #
            # This block used to add nothing here, and a request with no `page`
            # is not "unspecified" — the relay reads it as "the active tab",
            # whoever owns it. So an agent that had passed `--as` on every
            # single call, and believed itself isolated, drove another
            # container's tab: measured, seven navigations and seven clicks,
            # `ok: true` every time, with no signal on either side. The victim
            # cannot see it either — it addresses its tab by id, the tab still
            # exists, only the page inside changed.
            #
            # And this needs nobody to make a mistake. An identity loses its
            # remembered tab when the tab is closed, when an open failed, when
            # the state file cannot be read, and when the app restarts — which
            # invalidates every agent's remembered id at once.
            #
            # `--active` is the way to say "the tab in front, on purpose": it
            # clears `who` above, so it never reaches this branch. `--page`
            # names a tab explicitly and is already in `body`.
            print(no_tab_refusal(who, a.cmd), file=sys.stderr)
            return 1
            #
            # `--shared` is NOT that flag any more and reaches this branch like
            # every other identity. It used to clear `who` and so land here
            # bare — which is why its own help ("the DEFAULT profile, which is
            # the person's own session") was false: a request with no identity
            # and no page is the active tab, whoever owns it.
            #
            # …with ONE exemption, `minting_shared` above: `open --shared`
            # carries neither a page nor a profile on purpose, because the
            # person's container IS the empty profile field. It is the one
            # shape that looks un-addressed and is not, and without the
            # exemption `--shared` would have no way of ever getting a tab —
            # a refusal nobody can answer is a refusal that gets worked around.
            if not minting_shared:
                print(no_tab_refusal(who, a.cmd), file=sys.stderr)
                return 1

    # WHO IS ASKING, ON EVERY REQUEST — REQ-1's whole point. Written in
    # `stamped`, because the four verbs that return early above each sent a
    # body of their own and none of them carried it.
    body = stamped(a, body, who)
    # `--show` used to be a retry flag that never crossed the wire, so once
    # minting stopped taking the pane there was no way to buy the old
    # behaviour back — the trade the person was promised had no other half.
    # The panel honours `show` on a mint; this is the one place it is written.
    if a.cmd in ("open", "newtab") and a.show:
        body["show"] = True
        print("--show: the browser pane is brought forward for this tab", file=sys.stderr)

    res = call(a.cmd, body)
    # A tab of ours that is gone stops being ours, so the next call opens a
    # fresh one instead of addressing a ghost forever.
    if body.get("page") and str(res.get("error") or "").startswith("no tab called"):
        forget_tab(who)
        # And try once more, in the identity we already have: a tab that has
        # been closed is a reason to open another one, not a reason to stop.
        if a.cmd == "open" and who:
            body.pop("page", None)
            # …but NOT `profile: "(default)"` for `--shared`. The panel mints a
            # container for a name it does not know, so retrying the person's
            # own session under a literal name would build a second container
            # beside it and hand back a tab in the wrong one — the tab the
            # caller then remembers as theirs.
            # The same rule as above: a name for a named container, the empty
            # string for the person's own. Never the literal "(default)" — the
            # panel mints a container for any name it does not know, so that
            # would build a second one beside the person's and hand back a tab
            # in the wrong place.
            body["profile"] = who if named_profile else ""
            res = call(a.cmd, body)
    # WHAT COUNTS AS "we just minted a tab" IS NOT "the body carried a profile".
    #
    # `--shared` mints by sending nothing at all, so keying the remember on
    # `body["profile"]` left the person's own container the one identity that
    # never remembered where it landed — which is exactly how `--shared` came
    # to mean "the active tab" for every verb after the first.
    # A minting request is one that carried a profile AT ALL — `""` included,
    # which is the person's own container and the case a truthiness test drops.
    minted = "profile" in body
    if a.cmd in ("newtab", "open") and who and minted and not res.get("error"):
        made = res.get("value") if isinstance(res.get("value"), dict) else res
        remember_tab(who, (made or {}).get("id"))
    # AND `tab <id>` CHANGES WHICH ONE IS YOURS.
    #
    # Selecting a tab and then capturing without `--page` gave the tab this CLI
    # last OPENED, not the one just selected — so `tab A; shot` came back as B,
    # a valid picture of the wrong page, which is the same silent failure as
    # this morning with the parties swapped. Measured: `tabs` confirmed A was
    # active, `shot --page A` gave A's 53.233 bytes and a bare `shot` gave B's
    # 701.679.
    #
    # Asking for a tab by name is the clearest statement there is of which one
    # you mean, so it becomes the one every later verb goes to.
    # WHAT WAS ASKED FOR, not what the answer calls active.
    #
    # The first version of this read the `active` flag off the returned list and
    # it was always the PREVIOUS tab: the panel replies with the list it has in
    # hand, and the selection it just made has not reached that list yet. So the
    # fix recorded the tab we were leaving, which is worse than not recording at
    # all — measured, `tab t37` and the record still said t38.
    #
    # The caller named one. That is not ambiguous and it does not need a round
    # trip to confirm.
    if a.cmd == "tab" and who and not res.get("error"):
        rows = res.get("value") if isinstance(res.get("value"), list) else []
        if a.which.isdigit():
            i = int(a.which)
            row = rows[i] if 0 <= i < len(rows) else None
            if isinstance(row, dict) and row.get("id"):
                remember_tab(who, row["id"])
        else:
            remember_tab(who, a.which)
    # ── AND A TAB THAT IS GONE STOPS BEING YOURS ────────────────────────────
    #
    # `forget_tab` had ONE call site: the "no tab called" error path, reached
    # only after a request had already gone out naming a tab that no longer
    # exists. Closing your own tab, or dropping your own container, left the
    # map pointing at something gone and nothing noticed until the next verb
    # failed.
    #
    # That was survivable while a stale id fell through to the active tab. It
    # is not now: the fall-through is a refusal, so a stale entry is a wall the
    # caller cannot walk round — and pruning here is what lets the next `open`
    # self-heal by minting a fresh tab under the same identity.
    #
    # Pruning EAGERLY had to wait for that refusal, not precede it: before it,
    # dropping the entry would have removed the victim's only current signal.
    if a.cmd == "closetab" and who and not res.get("error"):
        mine = my_tab(who)
        # By id when the caller named one; by absence from the returned list
        # when they named an INDEX, which this side cannot resolve to an id.
        # `None` when the reply carried no list at all, which is the one case
        # where absence proves nothing. An EMPTY list is a list: closing the
        # last tab returns `[]`, and guarding this with `and rows` left the
        # entry alive after `closetab 0` — measured, the next `read` went out
        # addressed to a dead tab instead of being refused.
        rows = res.get("value") if isinstance(res.get("value"), list) else \
            (res.get("value") or {}).get("tabs") if isinstance(res.get("value"), dict) else None
        gone = mine and (
            mine == body.get("id")
            or (isinstance(rows, list)
                and not any(isinstance(r, dict) and r.get("id") == mine for r in rows))
        )
        if gone:
            forget_tab(who)
    if a.cmd == "profiles" and getattr(a, "drop", None) and not res.get("error"):
        # The container is gone, so every tab in it is gone. The identity whose
        # name it was is the one holding a dead id.
        forget_tab(a.drop)
    err = res.get("error") or ""
    # One retry, and only for the failure a retry can fix WITHOUT taking the
    # screen off the person using the app.
    #
    # "the browser view is not open" means no pane is mounted at all: nothing
    # can answer, there is no way round it, and telling an agent to ask a human
    # to click a tab is not an answer. That one is still opened and retried.
    #
    # "not on screen" is NOT. It used to be treated as the same thing, and it is
    # the reason this changed: a screenshot of a pane sitting behind the
    # terminal came back empty, so the CLI pulled the whole window over to the
    # browser — every shot, in the middle of somebody's work. The pane captures
    # while it is hidden now (see ag:captureBrowser), so that error means
    # something is genuinely wrong and it is reported rather than papered over.
    # `--show` asks for the old behaviour where a caller really does want the
    # pane brought to the front.
    fixable = "view is not open" in err or (a.show and "not on screen" in err)
    if not res.get("ok") and fixable:
        # Ask again BEFORE touching anybody's screen. The panel re-registers
        # itself for a moment whenever its tab changes, and a call that lands in
        # that gap is told the view is not open when it is — which used to yank
        # somebody out of the terminal mid-sentence.
        time.sleep(0.5)
        res = call(a.cmd, body)
        err = res.get("error") or ""
    if not res.get("ok") and "view is not open" in err:
        # And WAIT for a window that is merely still starting. A restart is a
        # second or two of "not registered yet", and every call that landed
        # there used to pull the app over to the browser.
        #
        # Only this error. `--show`'s "not on screen" is about a pane behind
        # another view, which registration has nothing to do with.
        if windows_ready(WAIT_TAIL):
            res = call(a.cmd, body)
            err = res.get("error") or ""
    # NOTHING BELOW MOVES ANYBODY'S SCREEN UNLESS THEY ASKED FOR IT.
    #
    # This used to switch the app to the browser view whenever a call could not
    # be answered, and that is the single most complained-about behaviour this
    # tool has: "I am working away quietly in my terminal… and it focuses the
    # browser on me. I go back to the terminal and it focuses the browser again…
    # up to four, five, six times."
    #
    # It is not a fix for anything either. The browser panel is mounted from
    # launch whether or not anybody goes to it (KEEP_RUNNING in the workspace),
    # so "the view is not open" almost always means the window is still
    # STARTING — a restart, an install — and the answer to that is to wait,
    # which costs a second and takes nobody's screen. If the wait runs out, the
    # honest answer is to say so.
    #
    # `--show` (or AGENTGLASS_BROWSER_SHOW=1) is the one way to the old
    # behaviour, for a caller who really does mean "bring it to the front".
    if not res.get("ok") and a.show and ("view is not open" in err or "not on screen" in err):
        if open_browser_view():
            time.sleep(2)
            res = call(a.cmd, body)

    if not res.get("ok"):
        print(res.get("error") or "the browser could not do that", file=sys.stderr)
        print_diagnosis(res.get("diagnosis"))
        return 1

    value = res.get("value") or {}

    # ── WHAT THE ANSWER SAYS ABOUT WHO ELSE IS IN HERE ──────────────────────
    #
    # §13(a). The notice fires wherever the tab list is already in hand, so it
    # costs nothing: `tabs` IS the list, and `profiles` now carries a count and
    # a last-activity per container. The condition is the same in both places —
    # this identity's container holds live tabs that this process did not open,
    # which is a JOIN wearing the clothes of a MINT.
    if a.cmd == "tabs" and who and not my_tab(who):
        held = sum(1 for r in value if isinstance(r, dict) and (r.get("profile") or "default") == who)
        foreign_container_notice(who, held)
    if a.cmd in ("open", "newtab") and who and isinstance(value, dict):
        # AND ON THE VERB THAT MINTS. `open --as NAME` with no remembered tab
        # either makes the container or joins one that already exists, and the
        # answer is `ok: true` either way — which is the whole defect.
        #
        # Read from the ANSWER rather than from a look-before-you-leap `tabs`
        # call: the panel replies with the tab list it now holds, so the other
        # agent's tabs are right there, and a pre-flight would have cost a
        # second round trip on the single most-used verb (11.0 ms per call
        # inside a process that has already paid 68.7 ms of startup) plus a
        # second line in every audit. What it would buy is 11 ms of warning
        # about a container that is shared either way: `open --as` MAKES a tab
        # here, it does not navigate somebody else's, so the notice is in time
        # to stop the work rather than in time to stop the tab.
        made = value.get("id")
        rows = value.get("tabs") if isinstance(value.get("tabs"), list) else []
        held = sum(1 for r in rows
                   if isinstance(r, dict) and (r.get("profile") or "default") == who
                   and r.get("id") != made)
        foreign_container_notice(who, held)
    if a.cmd == "profiles" and who and isinstance(value, dict) and not my_tab(who):
        for row in value.get("profiles") or []:
            if isinstance(row, dict) and row.get("name") == who:
                foreign_container_notice(who, row.get("tabs") or 0,
                                         row.get("lastActivityMs"), row.get("creator"))
    # And a drop that went through on a container nobody had claimed says so:
    # the ledger starts empty, so "no creator on record" is the ordinary state
    # of every container that was already on disk — silence there reads as
    # "it was mine", which is the assumption this whole change is about.
    if a.cmd == "profiles" and isinstance(value, dict) and value.get("warning"):
        _notice(f"profiles --drop: {value['warning']}")

    if a.cmd == "save":
        # To disk: an MHTML of a real page is megabytes, and a payload that
        # size in an agent's context is paid for on every turn afterwards.
        _write_private(a.out, value.get("mhtml", ""))
        print(a.out)
        return 0
    if a.cmd == "har" and a.out:
        _write_private(a.out, json.dumps(value, indent=2))
        print(a.out)
        return 0
    if a.cmd == "pdf":
        # To disk, not to the answer: a base64 PDF in an agent's context is
        # paid for on every turn for the rest of the session.
        raw = base64.b64decode(value.get("pdf", "") or "")
        if not raw:
            print("the page produced no PDF", file=sys.stderr)
            return 1
        with open(a.out, "wb") as f:
            f.write(raw)
        print(a.out)
        return 0


    # ── ONLY A CALL THAT ASKED FOR A CURSOR MOVES ONE ───────────────────────
    #
    # This used to advance on EVERY observe/console/network/exposed, under the
    # comment "whether or not THIS call asked for it — so the next one has a
    # cursor to read even the first time through". With one cursor per verb for
    # the whole machine, that meant agent A's ordinary polling silently moved
    # the floor under agent B: B's next `console --since-last` returned only
    # what happened after A's call, so B's own uncaught errors came back as an
    # empty list with exit code 0 — which reads as "no console errors". Always
    # in the under-report direction, which is the dangerous one for debugging.
    #
    # Per-identity keys (see `save_since`) fix the crossing; this fixes the
    # rest of it. A caller who never asks for a diff never writes one, so
    # nothing on this machine has a cursor it did not ask for. The cost is that
    # the FIRST `--since-last` returns the whole buffer once, which is what it
    # would have done anyway on a fresh state dir.
    if a.cmd in ("observe", "console", "network", "exposed") and getattr(a, "sinceLast", False):
        save_since(cursor, a.cmd, value.get("now"))

    # --max-tokens / --out / --summary apply to every verb except `shot`,
    # which already has its own --out-shaped positional (where to write the
    # png) and a binary payload there is nothing left to trim.
    if a.cmd != "shot":
        if a.maxTokens:
            value = budget_value(value, a.maxTokens)
        if a.outFile:
            _write_private(a.outFile, json.dumps(value))
            # The path AND a summary — writing to a file only to then print
            # the whole thing anyway would spend right back what it saved.
            print(a.outFile)
            print(summarize(a.cmd, value))
            return 0
        if a.summary:
            print(summarize(a.cmd, value))
            return 0

    if a.cmd == "health":
        print(value.get("summary", ""))
    elif a.cmd == "text":
        # Same reason as `read`: the caller is a model reading a page, and JSON
        # around one string is punctuation it pays for.
        print(value.get("text", ""))
    elif a.cmd == "read":
        # Plain text, because the caller is a language model reading a page —
        # wrapping it in JSON would spend tokens on punctuation.
        print(f"{value.get('title', '')}\n{value.get('url', '')}\n")
        print(value.get("text", ""))
    elif a.cmd == "shot":
        png = value.get("png", "")
        raw = base64.b64decode(png.split(",", 1)[1]) if "," in png else b""
        # NEVER WRITE A FILE WITH NO PIXELS IN IT.
        #
        # It wrote whatever came back, printed the path and exited 0 — so a
        # zero-byte PNG looked exactly like a good one, and this tool's own
        # help tells an agent to branch on the exit code. Two empty files with
        # evidence names ended up in somebody's proof-of-life folder that way.
        #
        # An empty capture is a FAILURE. Saying so costs a retry; not saying so
        # costs the trust in every capture this tool has ever produced.
        if not raw:
            print("the browser produced no pixels — nothing was written", file=sys.stderr)
            print_diagnosis(res.get("diagnosis"))
            return 1
        # Either spelling: `shot --out x.png` and `--out x.png shot`. The
        # second reaches the global flag, which skips `shot` because a binary
        # payload is not JSON to trim — but a person typing it means the same
        # thing both ways, and being told nothing while nothing is written is
        # the worst possible answer.
        # THREE spellings, and the POSITIONAL was the one nobody read.
        #
        # `shot out.png` is how the help itself writes it, and it printed a
        # base64 data url to stdout instead — a megabyte of it, into the
        # context of whoever ran it, with no file at the path they named. The
        # positional's dest is `out`; the code asked for `shotOut` and
        # `outFile` and never for that one.
        dest = (getattr(a, "shotOut", None) or getattr(a, "out", None)
                or getattr(a, "outFile", None))
        if dest:
            # Written whole and then moved into place, so an interrupted write
            # cannot leave a truncated PNG behind under the name of a good one.
            tmp = dest + ".part"
            with open(tmp, "wb") as f:
                f.write(raw)
            os.replace(tmp, dest)
            print(dest)
        else:
            print(png)
    else:
        print(json.dumps(value))
    return 0


if __name__ == "__main__":
    sys.exit(main())
