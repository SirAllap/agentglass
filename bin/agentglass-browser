#!/usr/bin/env python3
"""Drive agentglass's built-in browser — the one with your logins in it.

An agent can already fetch a URL from its shell and get the signed-out
version of everything that matters, because the session lives in a browser
and not in curl. This talks to the browser in the app window instead.

START HERE, in this order:

    agentglass-browser health                # is anything even listening
    agentglass-browser open https://example.com/app
    agentglass-browser observe --shot        # EVERYTHING at once: url, console,
                                             # network, the interactive tree, forms

Then the whole interaction in ONE call, which is the cheap way to work:

    agentglass-browser do "click #save" "wait #done" --observe

    Starting this process costs ~104ms before it says a word, so six separate
    verbs spend most of a second on startup alone. `do` spends it once.

THE VERBS, by what you reach for them for:

  look        observe · read · text · html · shot · frames · console · network
              shot --selector "#status" evidence.png       # just that element
              shot --highlight "#status" --label "still Online" evidence.png
  act         click · type · select · check · fill · hover · dblclick ·
              rightclick · focus · blur · press · scroll
  wait        wait · waitfor
  navigate    open · back · forward · reload
  tabs        tabs · tab · newtab · closetab · profiles
  identity    whoami · cookies · profiles · session · permissions
              whoami                              # BEFORE anything else: am I
                                                  # isolated, and who holds the screen
              profiles                            # who else is working, and on what
              open --as agent https://...        # log in once as this identity...
              session save agent.json             # ...save it...
              session load agent.json             # ...and reuse it, for ever
  run code    eval · addInitScript · expose · exposed
  inspect     cdp · listeners · coverage  (the DevTools protocol, whole)
  pretend     emulate · resize            (phone, timezone, dark mode, colour blindness)
  batch       do

YOUR IDENTITY IS DERIVED PER *SESSION*, NOT PER PROCESS. Without `--as`, the
name comes from the project and the last six characters of the session id — so
every SUBAGENT of one session derives the SAME name, the same container and the
same remembered tab, and because `open` navigates a remembered tab instead of
minting a new one, concurrent siblings repaint one shared page. The harness
offers no stable per-subagent id to fix this in the seed. So: A PARENT THAT
FANS OUT GIVES EACH CHILD AN EXPLICIT `--as` NAME. Two agents that pass the
same `--as` share one container — cookies, storage, login — machine-wide;
`whoami` and `profiles` are how you see that before it costs you an hour.

WHEN SOMETHING FAILS it tells you why without being asked: the console errors
and the failed requests from just before it. You do not need a second call.

Stdlib only, so it runs wherever the agent's shell runs. Exit code 0 when
the browser did the thing, 1 when it did not — an agent branches on that.

Every verb takes --max-tokens N, --out FILE (with --summary) and, on
observe/console/network, --since-last — because what a page returns is not
the cost, what stays in YOUR context for the rest of the session is (measured
82.7% of an agent's spend, over 17 real sessions). See --help on those verbs.

Env:
    AGENTGLASS_SERVER            base url (default http://localhost:4000)
    AGENTGLASS_TOKEN             only needed if the server was started with one
    AGENTGLASS_BROWSER_STATE_DIR where --since-last remembers its cursor
                                 (default ~/.cache/agentglass-browser)
"""
import argparse
import base64
import json
import os
import re
import sys
import time
import urllib.error
import urllib.request

try:
    import fcntl
except ImportError:  # pragma: no cover — POSIX only, which is where the app runs
    # Without it the tab map goes back to an unlocked read-modify-write. That
    # is not a crash, it is the 8%-of-races behaviour measured below; the CLI
    # is stdlib-only on purpose and must still start where fcntl is absent.
    fcntl = None


def _server_or_die(url):
    """Where the Bearer token goes. It is sent to whatever AGENTGLASS_SERVER
    names, and over plain http to a remote host it travels in the clear —
    every hop between here and there reads it. So: https anywhere, http only
    to this machine (localhost, or a loopback address). Anything else is one
    line on stderr and exit 2, before a single request is built."""
    import ipaddress
    from urllib.parse import urlsplit
    u = urlsplit(url)
    host = (u.hostname or "").lower()
    if u.scheme == "https" and host:
        return url
    if u.scheme == "http" and host:
        loop = host == "localhost"
        if not loop:
            try:
                loop = ipaddress.ip_address(host).is_loopback
            except ValueError:
                loop = False
        if loop:
            return url
        print(f"agentglass: refusing plain http to {host}: the token would travel in the clear. "
              f"Use https://, or http:// only to localhost/127.0.0.1/::1 (AGENTGLASS_SERVER={url})", file=sys.stderr)
        sys.exit(2)
    print(f"agentglass: AGENTGLASS_SERVER must be https://<host> or http://<loopback>, got {url!r}", file=sys.stderr)
    sys.exit(2)


SERVER = _server_or_die(os.environ.get("AGENTGLASS_SERVER", "http://localhost:4000").rstrip("/"))
STATE_DIR = os.environ.get("AGENTGLASS_BROWSER_STATE_DIR") or os.path.expanduser("~/.cache/agentglass-browser")


def _write_private(path, data, binary=False):
    """A file that may hold session material — cookies, storage, a HAR with
    its request headers, a snapshot of a signed-in page — written 0600. The
    plain `open(path, "w")` these used took the umask, 0644 on most machines:
    every account on the box could read the cookies `session save` had just
    pulled out of the browser. Created with the mode rather than chmod-ed
    after (the gap between the two is the same gap), and re-tightened when the
    file already existed, since O_CREAT's mode only applies to a new file."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.fchmod(fd, 0o600)
    except OSError:
        pass
    with os.fdopen(fd, "wb" if binary else "w") as f:
        f.write(data)


def _said_redacted(res):
    """The server counts what it masked (`redacted: {spans, fields}`) and every
    printer here dropped the field: `read` printed title, url and text, and a
    reader had no way to tell "[redacted]" in the page from "[redacted]" by
    us. Said once, on stderr, where every answer passes."""
    if isinstance(res, dict) and isinstance(res.get("redacted"), dict):
        r = res["redacted"]
        fields = ", ".join(sorted(k for k in (r.get("fields") or {}) if isinstance(k, str)))
        print(f"redacted: {r.get('spans', 0)} span(s) in {fields or 'the answer'} — "
              f"the [redacted] marks are ours, not the page's", file=sys.stderr)
    return res


def call(op, body):
    req = urllib.request.Request(
        f"{SERVER}/browser/{op}",
        data=json.dumps(body).encode(),
        method="POST",
        headers={
            "Content-Type": "application/json",
            # Same-origin is how the server tells a browser tab from everything
            # else; a CLI on this machine says so plainly.
            "Origin": SERVER,
        },
    )
    token = os.environ.get("AGENTGLASS_TOKEN")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            return _said_redacted(json.loads(r.read() or b"{}"))
    except urllib.error.HTTPError as e:
        try:
            return _said_redacted(json.loads(e.read() or b"{}"))
        except json.JSONDecodeError:
            return {"ok": False, "error": f"server said {e.code}"}
    except urllib.error.URLError as e:
        return {"ok": False, "error": f"no agentglass at {SERVER} ({e.reason})"}


# ── identity ────────────────────────────────────────────────────────────────
#
# Who is driving, and which tab is theirs. Both are remembered here rather than
# asked for on every call, because "declare your identity on every verb" is a
# rule that gets kept for ten minutes and then quietly stops being kept — which
# is exactly what happened: "the agents are using the browser but they are not
# creating their profiles; I am the one who has to tell them to."

# Said once per process, not once per call: `my_name` is asked three or four
# times on the way through `main`, and four copies of the same warning reads as
# four different problems.
_SAID = set()


def _notice(line):
    """A warning on stderr that does not change the exit code.

    stderr rather than stdout because stdout is the ANSWER — an agent pipes it
    into `jq` — and a notice mixed into it turns valid JSON into a parse error.
    """
    if line in _SAID:
        return
    _SAID.add(line)
    print(line, file=sys.stderr)


def _capped(name, source):
    """24 characters, and SAY SO when it bites.

    §13(b). The cap was silent, so two long, deliberately distinct names that
    differ only past byte 24 became ONE identity — one container, one cookie
    jar, one remembered tab — with nothing on either side saying it happened.
    That is the collision this whole change is about, arrived at by a caller
    who did everything right.
    """
    if len(name) <= 24:
        return name
    cut = name[:24]
    _notice(f'--as: "{name}" is longer than 24 characters and was cut to "{cut}" ({source}). '
            f"Two names that differ only past character 24 are ONE container, one cookie jar "
            f"and one tab. Pick a shorter one that is different at the start.")
    return cut


def my_name(explicit=None):
    """The identity this shell works as.

    Explicit name, then AGENTGLASS_PROFILE, then one derived from the session so
    that an agent has an identity WITHOUT having thought about it. Derived from
    the project and a short piece of the session id, so a person looking at the
    profile menu can tell whose it is and two sessions on one project do not
    collide.

    PER SESSION, WHICH IS NOT PER PROCESS. Subagents inherit
    CLAUDE_CODE_SESSION_ID from their parent, so every subagent of one session
    derives the same name and lands in one container — measured: three
    subagents of one session each derived the same six-character tail. A parent
    that fans out hands each child an explicit `--as`.
    """
    if explicit:
        return _capped(explicit, "the name you passed")
    env = os.environ.get("AGENTGLASS_PROFILE")
    if env:
        return _capped(env, "from AGENTGLASS_PROFILE")
    root = os.environ.get("CLAUDE_PROJECT_ROOT") or os.getcwd()
    stem = re.sub(r"[^A-Za-z0-9]", "", os.path.basename(root.rstrip("/")))[:12] or "agent"
    seed = (os.environ.get("CLAUDE_CODE_SESSION_ID")
            or os.environ.get("TMUX_PANE", "").lstrip("%")
            or str(os.getppid()))
    tail = re.sub(r"[^A-Za-z0-9]", "", seed)[-6:] or "0"
    # No notice on this branch: the stem is already cut to 12 and the tail to
    # 6, so a derived name cannot reach 24 — warning about a cap that never
    # fires would train a reader to ignore the one that does.
    return f"{stem}-{tail}"[:24]


# THE PERSON'S OWN CONTAINER IS AN IDENTITY LIKE ANY OTHER.
#
# `--shared` promised "the DEFAULT profile, which is the person's own session"
# and delivered "whichever tab is in front". It set the identity to the empty
# string, `remember_tab` refuses a falsy name, so `my_tab("")` was always None
# and the request left with neither `profile` nor `page` — byte-equivalent to
# an un-addressed call, which the relay resolves to the globally active tab.
# That tab belongs to whoever last used the browser, agents included.
#
# So the person's container gets a slot in the tab map like everybody else,
# and `--shared open` remembers the tab it lands in, and every `--shared` verb
# after it names that tab instead of guessing.
#
# NOT `profile: "default"` on the wire. The panel resolves a profile name by
# lookup and MINTS a container when the name is unknown, and the person's own
# session is the EMPTY profile field rendered with the label "default" — so
# the literal string would create a brand-new container called "default"
# beside the session it was meant to enter. `--shared` therefore still sends
# no profile at all; what changed is that it stops forgetting where it landed.
#
# Parentheses on purpose: `my_name` strips everything that is not a letter or
# a digit before it builds a derived name, so no identity can arrive here by
# accident. A caller who types `--as "(default)"` gets the person's container,
# which is what those characters now mean.
SHARED_KEY = "(default)"


def _tabs_path():
    return os.path.join(STATE_DIR, "my-tabs.json")


class _map_lock:
    """An exclusive lock around ONE read-modify-write of the tab map.

    `os.replace` makes each write atomic. It does not make the cycle atomic,
    and the cycle is what two agents run at the same time: both read the map,
    both add their own key, the second write drops the first. Measured on this
    machine with two processes calling `remember_tab` once each against a fresh
    state dir, 200 iterations: **16 of 200 lost an identity** — 8%. Confirmed
    end to end through the CLI with the lock taken back out: 4 of 60.

    Losing a key is not "the caller retries". Under the refusal an identity
    with no tab now gets, it is a call that STOPS, for a tab that is open and
    working, because somebody else opened one at the same millisecond.

    A separate `.lock` file rather than the map itself: the map is replaced by
    `os.replace`, so a lock held on its inode would stop describing the file
    the next reader opens.
    """

    def __enter__(self):
        self.fd = None
        if fcntl is None:
            return self
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            self.fd = os.open(_tabs_path() + ".lock", os.O_CREAT | os.O_RDWR, 0o600)
            fcntl.flock(self.fd, fcntl.LOCK_EX)
        except OSError:
            # An unwritable state dir is the REQ-18 case below: it costs the
            # automatic targeting, not the call. Do not make it cost the lock.
            if self.fd is not None:
                try:
                    os.close(self.fd)
                except OSError:
                    pass
            self.fd = None
        return self

    def __exit__(self, *exc):
        if self.fd is not None:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_UN)
            finally:
                os.close(self.fd)
        return False


def my_tab(name):
    """The tab this identity opened, if it still has one."""
    try:
        with open(_tabs_path()) as f:
            return (json.load(f) or {}).get(name) or None
    except Exception:
        return None


def _write_map(held):
    tmp = _tabs_path() + ".tmp"
    with open(tmp, "w") as f:
        json.dump(held, f)
    os.replace(tmp, _tabs_path())


def remember_tab(name, tab_id):
    """Written after `open`/`newtab` so every later verb can name it.

    Best effort: a state file that cannot be written costs the automatic
    targeting, not the call. The caller can always pass --page itself.

    BUT IT SAYS SO NOW. This ended `except Exception: pass` under that
    docstring, so an unwritable cache directory turned targeting off in
    silence — and silent targeting-off is exactly the state in which the next
    verb goes somewhere the caller did not choose. One line on stderr, which
    is not stdout and so cannot corrupt an answer a script is parsing.
    """
    if not name or not tab_id:
        return
    try:
        with _map_lock():
            os.makedirs(STATE_DIR, exist_ok=True)
            try:
                with open(_tabs_path()) as f:
                    held = json.load(f) or {}
            except Exception:
                held = {}
            held[name] = tab_id
            _write_map(held)
    except Exception as e:
        print(f"agentglass-browser: could not remember this tab in {STATE_DIR} ({e}) — "
              f"automatic targeting is off for {name}; pass --page <tab id> to name it",
              file=sys.stderr)


def forget_tab(name):
    """After a tab is closed, or found to be gone.

    Called from the "no tab called" error path, from `closetab`, and from
    `profiles --drop`. It had exactly ONE of those three call sites, so closing
    your own tab or dropping your own container left the map pointing at
    something gone — which was harmless only while a stale id fell through to
    the active tab. It does not fall through any more, so a stale entry is now
    a refusal the caller cannot act on, and pruning is what makes the next
    `open` self-heal.
    """
    try:
        with _map_lock():
            with open(_tabs_path()) as f:
                held = json.load(f) or {}
            if held.pop(name, None) is None:
                return
            _write_map(held)
    except Exception:
        pass


def _ago(ms):
    """"41 seconds ago", or a date once that stops meaning anything.

    A timestamp answers the wrong question. What an agent about to join a
    container needs to know is whether somebody is in there NOW, and
    "1788264861111" makes it work that out. Nothing is returned for a missing
    value: no clock is better than a wrong one.
    """
    if not isinstance(ms, (int, float)) or ms <= 0:
        return None
    secs = int(time.time() - ms / 1000.0)
    if secs < 0:
        return "just now"
    if secs < 90:
        return f"{secs} seconds ago"
    if secs < 5400:
        return f"{secs // 60} minutes ago"
    if secs < 172800:
        return f"{secs // 3600} hours ago"
    return f"{secs // 86400} days ago"


def foreign_container_notice(who, live_tabs, last_ms=None, creator=None):
    """§13(a). YOU ARE ABOUT TO WORK IN SOMEBODY ELSE'S CONTAINER.

    Minting a container and joining one somebody else made are the same
    gesture — `--as pol` — and nothing about the answer says which of the two
    just happened. The panel resolves a container by NAME against a
    machine-wide list and only mints when the name is absent, so two shells
    that pick the same name share one cookie jar, one login, and (because
    `open` navigates a remembered tab rather than minting) one page.

    The signal that this is a JOIN and not a MINT: the container already holds
    live tabs that this process did not open. `my_tab` is per-process state, so
    "tabs exist in my container and none of them is mine" is exactly the shape
    of a collision — and it is the shape the incident had.

    A notice, not a refusal. Two shells of one agent sharing a container on
    purpose is a documented, useful pattern (`session save` / `session load`),
    and the caller may well mean it. What was missing was being told.
    """
    if not who or live_tabs <= 0:
        return
    when = _ago(last_ms)
    line = (f'--as {who}: that container already exists and holds {live_tabs} '
            f'tab{"" if live_tabs == 1 else "s"} this process did not open')
    if creator:
        line += f", created by {creator}"
    if when:
        line += f", last used {when}"
    _notice(line + ".\n"
            "  You are JOINING it, not making one: same cookies, same login, same storage, "
            "and an `open` here can navigate the page somebody else is looking at.\n"
            f"  Yours would be: agentglass-browser --as {who}-2 open <url>   (or any name nobody has)\n"
            "  Who holds what: agentglass-browser profiles")


def _since_path():
    return os.path.join(STATE_DIR, "since.json")


def load_since(who, cmd):
    """The cursor `--since-last` remembers for one identity's verb, or 0.

    Kept in a file rather than in this process, because a fresh process is
    exactly what an agent starts for every call — there is no in-memory
    session to remember it for.

    KEYED ON THE IDENTITY, NOT JUST THE VERB. It used to be one number per
    verb in one machine-global file, so every agent on the machine shared four
    cursors — the live file had exactly four keys (`observe`, `console`,
    `network`, `exposed`) and its `exposed` cursor was 5.5 days older than its
    `observe` one, cursors from different sessions and different days sitting
    in the same slot.

    That is not a tidiness problem. Agent A's ordinary `console` moved the
    floor under agent B, so B's next `console --since-last` returned the
    errors since A's call — an empty list, exit code 0, which reads as "no
    console errors". The error is always in the under-report direction, which
    is the dangerous one for debugging: B is querying the right tab (the
    console buffer is per page) with the wrong floor.

    A cursor that cannot be parsed still yields 0, which returns the whole
    buffer. That costs tokens and loses nothing, and it keeps a read verb from
    failing because of a cache — this tool's own contract is that a bad state
    file costs the targeting, not the call.
    """
    try:
        with open(_since_path()) as f:
            mine = (json.load(f) or {}).get(who) or {}
        return float(mine.get(cmd, 0) or 0)
    except Exception:
        return 0.0


def save_since(who, cmd, now):
    """Remember `now` for next time, for THIS identity's verb.

    Best-effort: a caller that cannot write its own cache directory should
    still get today's answer, just without tomorrow's diff.

    Written tmp + `os.replace` like the tab map. It used to be a plain
    truncating `open(path, "w")`, so a process killed mid-write left a
    half-written cursor file — which `load_since` then reads as 0 for every
    identity in it, not just the one being written.
    """
    if not isinstance(now, (int, float)) or not who:
        return
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        try:
            with open(_since_path()) as f:
                state = json.load(f)
        except Exception:
            state = {}
        if not isinstance(state, dict):
            state = {}
        # The old flat shape put a float under the VERB name at top level.
        # Anything here that is not a dict is a cursor from before this change
        # and is replaced rather than migrated: the spec's own note is that the
        # first `--since-last` after this returns the whole buffer once, which
        # is self-correcting, and guessing which identity an old cursor
        # belonged to is not possible.
        if not isinstance(state.get(who), dict):
            state[who] = {}
        state[who][cmd] = now
        tmp = _since_path() + ".tmp"
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, _since_path())
    except Exception:
        pass


def _size(v):
    return len(json.dumps(v))


def budget_value(value, max_tokens):
    """Truncate a verb's answer to roughly `max_tokens`, by RELEVANCE rather
    than by lopping off whatever came last.

    The 3000-line DOM dump is the anti-feature this whole verb exists to
    avoid, so the order matters: a page's tree is trimmed to what is in the
    VIEWPORT first (a caller reading a page cares about what it can see, not
    what is below the fold), console/network logs drop their OLDEST rows
    first (the most recent is what a caller just triggered), and only a
    plain text/html blob is cut at all, because there is nothing left in it to
    prioritise. Nothing is silently dropped: `truncated`/`budgetNote` say
    exactly what left and how much of it there was.
    """
    if not isinstance(value, dict) or not max_tokens:
        return value
    budget_chars = max_tokens * 4  # a rough, well-known ratio — good enough to aim a cut, not to promise a count
    if _size(value) <= budget_chars:
        return value
    notes = []

    tree = value.get("tree")
    if isinstance(tree, list) and tree:
        vp = value.get("viewport") or {}
        vw, vh = vp.get("width"), vp.get("height")

        def onscreen(el):
            at = el.get("at")
            if not at or vw is None:
                return True
            x, y, w, h = at
            return x < vw and y < vh and x + w > 0 and y + h > 0

        ordered = sorted(range(len(tree)), key=lambda i: (0 if onscreen(tree[i]) else 1, i))
        value["tree"] = [tree[i] for i in ordered]
        while _size(value) > budget_chars and len(value["tree"]) > 1:
            value["tree"].pop()
        dropped = len(tree) - len(value["tree"])
        if dropped:
            notes.append(f"tree: kept {len(value['tree'])} of {len(tree)} (viewport first), dropped {dropped}")

    for key in ("console", "network"):
        arr = value.get(key)
        if _size(value) <= budget_chars:
            break
        if isinstance(arr, list) and arr:
            before = len(arr)
            while _size(value) > budget_chars and len(value[key]) > 0:
                value[key] = value[key][1:]  # oldest first — the newest is what the caller is asking about
            dropped = before - len(value[key])
            if dropped:
                notes.append(f"{key}: dropped {dropped} oldest of {before}")

    rows = value.get("rows")
    if _size(value) > budget_chars and isinstance(rows, list) and rows:
        before = len(rows)
        while _size(value) > budget_chars and len(value["rows"]) > 0:
            value["rows"] = value["rows"][1:]
        dropped = before - len(value["rows"])
        if dropped:
            notes.append(f"rows: dropped {dropped} oldest of {before}")

    for key in ("text", "html"):
        s = value.get(key)
        if _size(value) <= budget_chars:
            break
        if isinstance(s, str) and s:
            over = _size(value) - budget_chars
            keep = max(0, len(s) - over - 20)
            value[key] = s[:keep]
            if keep < len(s):
                notes.append(f"{key}: cut to {keep} of {len(s)} chars")

    if notes:
        value["truncated"] = True
        value["budgetNote"] = "; ".join(notes)
    return value


def emit(cmd, value, a):
    """Print an answer the way every verb is documented to: --max-tokens trims
    it, --out writes it, --summary describes it.

    It lived at the bottom of main() and the verbs that return EARLY — `cdp`,
    `do` — never reached it. So `cdp --out file.json` printed the whole answer
    to stdout, wrote nothing, and exited 0: the caller pays for the payload in
    its context, which is the exact cost --out exists to avoid, and finds no
    file where it was told one would be."""
    if getattr(a, "maxTokens", None):
        value = budget_value(value, a.maxTokens)
    if getattr(a, "outFile", None):
        _write_private(a.outFile, json.dumps(value))
        print(a.outFile)
        print(summarize(cmd, value))
        return 0
    if getattr(a, "summary", False):
        print(summarize(cmd, value))
        return 0
    print(json.dumps(value))
    return 0


def summarize(cmd, value):
    """One line for `--summary` — the thing worth reading when the rest went
    to a file instead of your context."""
    if not isinstance(value, dict):
        return str(value)[:200]
    if cmd == "observe":
        bits = [f"{value.get('title', '')!r}", value.get("url", ""),
                f"tree:{len(value.get('tree') or [])}",
                f"console:{len(value.get('console') or [])}",
                f"network:{len(value.get('network') or [])}"]
        if value.get("visible") is False:
            bits.append("NOT VISIBLE")
        return " ".join(bits)
    if cmd in ("console", "network"):
        rows = value.get("rows") or []
        return f"{len(rows)} rows" + (f", {value['dropped']} dropped" if value.get("dropped") else "")
    if cmd == "read":
        return f"{value.get('title', '')!r} {value.get('url', '')} — {len(value.get('text', ''))} chars"
    if cmd in ("whoami", "profiles"):
        # The one line that matters here is not a size, it is the three facts
        # §11 exists for: who am I, do I still hold a tab, and whose container
        # is on screen. `N bytes of json` answered none of them.
        you = value.get("you") or {}
        act = value.get("activeTab") or {}
        bits = [f"you={you.get('identity') or '(shared)'}",
                "tab=" + (f"{you.get('tab')} live" if you.get("tabLive") else "NONE"),
                f"screen={act.get('profile') or '?'}"]
        if cmd == "profiles":
            bits.append(f"containers:{len(value.get('names') or [])}")
        return " ".join(bits)
    if "html" in value:
        return f"{len(value.get('html', ''))} chars of html"
    if "text" in value:
        return f"{len(value.get('text', ''))} chars"
    return f"{_size(value)} bytes of json"


# How long to keep waiting for a window that is still starting, once the quick
# look has already failed. Bounded on purpose: nothing opens a pane any more —
# that was the screen theft — so all this can do is wait and then say so, and an
# agent blocked for ten seconds is its own kind of theft.
WAIT_TAIL = float(os.environ.get("AGENTGLASS_BROWSER_WAIT") or 2.5)


def windows_ready(seconds=1.6):
    """Wait for a window to say it can drive a browser.

    The app registers itself a moment after its renderer is up, and a restart is
    seconds of that moment — so a call landing in it is told "the browser view
    is not open" about a window that is simply still starting. Switching the app
    to the browser then is the worst possible answer: it takes the screen off
    whoever is using it, and it happens EVERY time, which is what was reported —
    "every reinstall drags me to the browser view… three or four times over".

    So the wait comes first. This is a read; it opens nothing and moves nothing.
    """
    deadline = time.time() + seconds
    while True:
        req = urllib.request.Request(f"{SERVER}/browser-use/status")
        token = os.environ.get("AGENTGLASS_TOKEN")
        if token:
            req.add_header("Authorization", f"Bearer {token}")
        try:
            with urllib.request.urlopen(req, timeout=3) as r:
                if json.loads(r.read()).get("windows", 0) > 0:
                    return True
        except Exception:
            # Nothing to wait FOR: a server that cannot be asked is not a window
            # that is starting, and waiting five seconds to find that out is
            # five seconds an agent spends learning nothing.
            return False
        if time.time() >= deadline:
            return False
        time.sleep(0.4)


def open_browser_view():
    """Ask the window to show the browser pane.

    The pane is where the guest lives, so nothing can answer until it is
    mounted — and telling an agent to ask a human to click a tab is not an
    answer. This is the same command a Stream Deck sends; it opens a panel and
    grants nothing else.
    """
    req = urllib.request.Request(
        f"{SERVER}/control",
        data=json.dumps({"cmd": "view", "to": "browser"}).encode(),
        method="POST",
        headers={"Content-Type": "application/json", "Origin": SERVER},
    )
    token = os.environ.get("AGENTGLASS_TOKEN")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            r.read()
        return True
    except Exception:
        return False


# The verbs whose one argument is obvious, so `do "click #save"` can mean what
# it looks like. Anything with a second argument — type's text, resize's height
# — goes through --steps-file, because guessing at a second positional is how a
# short form starts lying about what it ran.
# The argument each verb takes in the short form of `do`, under the name the
# SERVER reads it by. Two of these were wrong and both failed silently in the
# middle of a chain, which is the worst place for it — the steps before had
# already run:
#
#   "eval": "expr"      the server reads `js`, so every `do "eval ..."` came
#                       back "js must be a non-empty expression under 20k"
#                       for an expression that was right there.
#   "waitfor": "selector"  waitfor takes a CONDITION, not a selector, so
#                       `do "waitfor #done"` sent "#done" as JavaScript and the
#                       page answered with a SyntaxError about a private field.
#                       The help printed that exact example.
DO_ONE_ARG = {
    "open": "url", "click": "selector", "wait": "selector", "waitfor": "js",
    "text": "selector", "html": "selector", "press": "key", "eval": "js",
    "hover": "selector", "focus": "selector", "blur": "selector", "check": "selector",
    "dblclick": "selector", "rightclick": "selector",
}


def _at(page, body):
    """`body`, addressed to `page` — and unchanged when there is no page, which
    is only ever the deliberate `--shared`."""
    if page:
        body = dict(body)
        body["page"] = page
    return body


def stamped(a, body, who=None):
    """`body` with the caller written on it: `as`, `how`, and `pageExplicit`
    when the operator typed `--page`. ONE place, for every request.

    The panel's cross-container check reads `as` and treats its ABSENCE as
    "cannot tell", which it must: the MCP surface and hand-written clients
    send none. So a request that never carries it turns the check into a
    no-op — measured against the installed build, `--page <another
    container's tab> click body` came back `ok` with the other container's
    URL in the answer. Four lanes' worth of ownership machinery, unreachable
    for want of one field.

    And that field was stamped in the main path only. `session`, `permissions`,
    `cdp` and `do` return three hundred lines earlier, each with a body of its
    own, and every one of them went out bare — `do` above all, the incident's
    own vector: a read-only batch has no leading `open` to overwrite the page,
    so an unattributed one returns another container's page verbatim.

    `how` rides with `as` so the audit can tell `--page t7` (a person meaning
    somebody else's tab) from the CLI stamping this identity's own t7: the two
    are the same field on the wire and only this process knows which. And
    `pageExplicit` is the exemption the cross-container check honours — the
    operator TYPED the address, as opposed to the CLI filling it in from the
    tab map.
    """
    if who is None:
        who = acting_as(a)
    body = dict(body)
    if who:
        body.setdefault("as", who)
    if getattr(a, "page", None):
        body["pageExplicit"] = True
    body.setdefault("how", (
        "explicit-page" if getattr(a, "page", None)
        else "active-explicit" if getattr(a, "active", False)
        else "shared" if not who
        else "own-tab" if body.get("page")
        else "own-container"))
    return body


def acting_as(a):
    """The identity this call works as — resolved in ONE place.

    `--shared` is an identity too, and that is the whole of REQ-4: the person's
    own container is a container, so it gets a slot in the tab map and stops
    meaning "whatever is in front". `--active` is the flag for that meaning
    now, and it has no identity at all.
    """
    if getattr(a, "active", False):
        return ""
    if getattr(a, "shared", False):
        return SHARED_KEY
    return my_name(getattr(a, "asProfile", None))


def addressed(a, cmd=None):
    """The tab this call must act on, or `None` when the caller must be refused.

    THE FOUR VERBS THAT RETURN EARLY NEVER ASKED THIS. `session`, `permissions`,
    `cdp` and `do` answer three hundred lines before identity is resolved, so
    `--as NAME` was parsed and thrown away for them — and a request that names
    no tab is not "unspecified" to the relay, it is "the tab in front", whoever
    owns it. `session save` is the worst of the four: it dumps cookies AND
    localStorage out of whatever page happens to be there.

    Returns `("", None)` for `--active`, which is the way to say "the tab in
    front, whoever owns it, deliberately"; `(tab_id, None)` for an identity
    that has one — `--shared` included, whose identity is the person's own
    container; and `(None, message)` for an identity that does not, which is a
    refusal rather than a fall-through.
    """
    if getattr(a, "active", False):
        return "", None
    if getattr(a, "page", None):
        return a.page, None
    who = acting_as(a)
    mine = my_tab(who)
    if mine:
        return mine, None
    return None, no_tab_refusal(who, cmd or getattr(a, "cmd", "this"))


def no_tab_refusal(who, verb):
    """THE ONE SENTENCE, said in one place.

    There were three copies of it, and they had already drifted: two named
    `--shared` as the way to reach the front tab, which stopped being true when
    `--shared` became the person's own container, so the refusal was sending
    people at the very call that drives another agent's page. A refusal is the
    only thing a stuck caller reads; it does not get to be out of date.
    """
    return (
        f'{verb}: "{who}" has no tab open, so this would have gone to whichever tab is '
        f"in front — which may belong to another agent.\n"
        f"  check first:   agentglass-browser whoami        (this is the tabLive: false it reports)\n"
        f"  open one:      agentglass-browser {_open_as(who)} open <url>\n"
        f"  or name a tab: agentglass-browser --page <tab id> {verb} ...\n"
        f"  or say you mean the active one: agentglass-browser --active {verb} ...\n"
        f"  (--shared means the person's own container, which is a container "
        f"like any other and needs a tab open in it too)"
    )


def cursor_key(a):
    """Whose reading floor `--since-last` is remembering.

    The identity when there is one — `--shared` included, since the person's
    container has a console buffer of its own like every other container.
    `--active` names a tab without naming an identity, so it falls back to the
    one this shell derives for itself: the cursor is about WHO READ, and a
    caller that deliberately borrows the front tab is still its own reader. It
    must not land in a shared slot, because a shared slot is the whole defect.
    """
    return acting_as(a) or my_name(getattr(a, "asProfile", None))


def _open_as(who):
    """How the caller would open a tab for `who`, in their own words.

    `--as (default)` is not a thing anybody should be told to type; the flag
    for the person's own container is `--shared`.
    """
    return "--shared" if who == SHARED_KEY else f"--as {who}"


def do_steps(a):
    """The steps for `do`, from a file or from the short form."""
    if a.steps_file:
        try:
            with open(a.steps_file) as f:
                steps = json.load(f)
        except (OSError, ValueError) as e:
            print(f"could not read {a.steps_file}: {e}", file=sys.stderr)
            return None
        if not isinstance(steps, list):
            print("--steps-file must hold a JSON list of {op, args}", file=sys.stderr)
            return None
        return steps
    if not a.step:
        print("do needs steps: do 'click #save' 'wait #done', or --steps-file", file=sys.stderr)
        return None
    steps = []
    for raw in a.step:
        parts = raw.split(None, 1)
        op = parts[0]
        if len(parts) == 1:
            steps.append({"op": op, "args": {}})
            continue
        key = DO_ONE_ARG.get(op)
        if not key:
            print(f"{op} takes more than one argument — use --steps-file for it", file=sys.stderr)
            return None
        steps.append({"op": op, "args": {key: parts[1]}})
    return steps


def steps_at(steps, page):
    """Every step of a batch, addressed to `page`.

    THE PAGE ON THE BATCH BODY IS NOT AN ADDRESS. `/browser/do` reads
    `b.steps` and hands them to `runSteps`, which re-parses each step through
    `parseAsk` — and `parseAsk` builds a fresh `args` object per op, so a key
    on the OUTER body reaches nothing (`server/src/index.ts`: the non-lane
    branch is `runSteps(b.steps, {observe})`, and `b.page` is never read).
    The address that lands is the one on each step, which `parseAsk` copies
    for every op outside its `pageOps` set.

    That is the whole of PATH 1 of the incident. `do` sent `{"steps": …}` and
    returned three hundred lines before identity was resolved, so `--as` — which
    the offending script passed on EVERY invocation — was discarded in full:
    measured seconds apart within one script, the six-separate-invocation arm
    routed `page: t4-39xgg3` on every verb while the `do` arm went bare on all
    six, and that alternation repeats seven times. Sixty-three bare calls, of
    which fourteen navigated or clicked in another agent's tab.

    A STEP THAT NAMES ITS OWN PAGE KEEPS IT. `--steps-file` passes file-sourced
    JSON through verbatim with no key filtering, and a step carrying its own
    `page` is the only multi-tab batch form that works today. Overwriting it
    would break the one deliberate use of this while claiming to fix the
    accidental one.
    """
    if not page:
        return steps
    out = []
    for st in steps:
        if not isinstance(st, dict):
            # Let the server say what is wrong with it; this is not the place
            # to invent a second validator for the batch format.
            out.append(st)
            continue
        args = st.get("args")
        args = dict(args) if isinstance(args, dict) else {}
        args.setdefault("page", page)
        out.append({**st, "args": args})
    return out


def print_diagnosis(d):
    """What a failure carries with it, printed under the refusal (spec 15).

    The refusal itself is the first line and stays exactly what the page said,
    because a caller greps it and a test pins it. This goes to stderr under it,
    only when there is something to say: a page that failed before anything
    could be read attaches nothing, and printing an empty heading in that case
    would be noise on every early failure.
    """
    if not isinstance(d, dict):
        return
    errs = d.get("consoleErrors") or []
    reqs = d.get("failedRequests") or []
    if not errs and not reqs:
        return
    print("", file=sys.stderr)
    if errs:
        print("console errors just before this:", file=sys.stderr)
        for r in errs:
            where = r.get("source") or ""
            print("  " + str(r.get("text", ""))[:300] + ("  (" + where + ")" if where else ""), file=sys.stderr)
    if reqs:
        print("requests that failed just before this:", file=sys.stderr)
        for r in reqs:
            status = r.get("status")
            print("  {} {} {}".format(status if status else "no answer",
                                      r.get("method", ""), str(r.get("url", ""))[:200]), file=sys.stderr)


STORAGE_READ_JS = (
    "(() => { const ls = {}; for (const k of Object.keys(localStorage)) ls[k] = localStorage.getItem(k); "
    "const ss = {}; for (const k of Object.keys(sessionStorage)) ss[k] = sessionStorage.getItem(k); "
    "return { origin: location.origin, localStorage: ls, sessionStorage: ss }; })()"
)


def session_save(path, page="", a=None):
    """The 40-minute magic-link dance, replaced by one file. Cookies come
    through CDP (`Network.getCookies`), not `document.cookie` — the session
    cookie a real login sets is usually httpOnly, and a page can never read
    that one back for itself. Storage comes out in playwright's storage-state
    shape (cookies + origins[].localStorage), with sessionStorage added
    alongside it — it has no meaning restored into a brand new context, but
    reloading the SAME tab this file came from should come back exactly as it
    left.

    IT READS THE CALLER'S OWN TAB, NOT "whatever page is open right now".
    That sentence is what this docstring used to say, and it was the worst of
    the four early returns: an unaddressed `session save` dumps the cookies
    AND the localStorage of whichever tab happens to be in front — the single
    most valuable thing a hijacked tab holds, written to a file, in silence.

    This is a deliberate behaviour change and it costs one real flow: logging
    in by hand in the front tab and then saving it. `--shared` (the person's
    own container) and `--page <tab id>` are the escape hatch for that, and
    `--active` for the old meaning exactly.
    """
    cookies_res = call("cdp", stamped(a, _at(page, {"method": "Network.getCookies"})))
    if not cookies_res.get("ok"):
        print(cookies_res.get("error") or "could not read cookies", file=sys.stderr)
        return 1
    cookies = ((cookies_res.get("value") or {}).get("result") or {}).get("cookies", [])
    storage_res = call("eval", stamped(a, _at(page, {"js": STORAGE_READ_JS, "await": False})))
    if not storage_res.get("ok"):
        print(storage_res.get("error") or "could not read storage", file=sys.stderr)
        return 1
    storage = (storage_res.get("value") or {}).get("value") or {}
    origin = storage.get("origin", "")
    state = {
        "cookies": cookies,
        "origins": [{
            "origin": origin,
            "localStorage": [{"name": k, "value": v} for k, v in (storage.get("localStorage") or {}).items()],
            "sessionStorage": [{"name": k, "value": v} for k, v in (storage.get("sessionStorage") or {}).items()],
        }],
    }
    _write_private(path, json.dumps(state, indent=2))
    print(f"{path}: {len(cookies)} cookies, {len(state['origins'][0]['localStorage'])} localStorage keys, "
          f"{len(state['origins'][0]['sessionStorage'])} sessionStorage keys, from {origin or '(no page open)'}")
    return 0


def session_load(path, page="", a=None):
    """The reverse of `session save`. Cookies go back through CDP so they
    keep httpOnly and Secure; storage is written by the page itself, which
    means the page this loads onto must already be `open` on the origin the
    file was saved from — a script on one origin was never going to write
    another one's localStorage, and this does not get to either.
    """
    try:
        with open(path) as f:
            state = json.load(f)
    except (OSError, ValueError) as e:
        print(f"could not read {path}: {e}", file=sys.stderr)
        return 1
    cookies = state.get("cookies") or []
    for c in cookies:
        params = {k: v for k, v in c.items()
                 if k in ("name", "value", "url", "domain", "path", "secure", "httpOnly", "sameSite", "expires")}
        if "domain" in params and "url" not in params:
            # `Network.setCookie` needs a url when there is no domain+path pair
            # CDP itself would accept unambiguously; getCookies' own answer
            # never carries one, only domain — build it rather than fail every
            # cookie this reads back.
            scheme = "https" if params.get("secure") else "http"
            params["url"] = f"{scheme}://{str(params['domain']).lstrip('.')}{params.get('path', '/')}"
        r = call("cdp", stamped(a, _at(page, {"method": "Network.setCookie", "params": params})))
        if not r.get("ok"):
            print(f"cookie {c.get('name')}: {r.get('error')}", file=sys.stderr)
    ls_count = ss_count = 0
    for o in state.get("origins") or []:
        ls = {e["name"]: e["value"] for e in o.get("localStorage") or []}
        ss = {e["name"]: e["value"] for e in o.get("sessionStorage") or []}
        ls_count += len(ls)
        ss_count += len(ss)
        js = (
            f"(() => {{ const ls = {json.dumps(ls)}; for (const k in ls) localStorage.setItem(k, ls[k]); "
            f"const ss = {json.dumps(ss)}; for (const k in ss) sessionStorage.setItem(k, ss[k]); return true; }})()"
        )
        r = call("eval", stamped(a, _at(page, {"js": js, "await": False})))
        if not r.get("ok"):
            print(r.get("error") or "could not write storage", file=sys.stderr)
            return 1
    print(f"{path}: {len(cookies)} cookies, {ls_count} localStorage keys, {ss_count} sessionStorage keys restored")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="agentglass-browser", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    # The subcommand list is 35 names long and argparse prints it as one
    # unreadable run-on line. The grouped map in the description above IS the
    # index; this stops the wall of text from burying it.
    ap._positionals.title = "verbs (see the grouped list above)"
    # Before the verb: `agentglass-browser --show shot out.png`. Off by default
    # because taking over somebody's window is not a side effect a screenshot
    # gets to have; AGENTGLASS_BROWSER_SHOW=1 turns it on for a whole process
    # rather than one call.
    ap.add_argument("--show", action="store_true",
                    default=os.environ.get("AGENTGLASS_BROWSER_SHOW", "") not in ("", "0", "false"),
                    help="bring the browser view to the front: a tab this opens takes the pane, "
                         "and a hidden pane is opened and the call retried")
    ap.add_argument("--no-show", action="store_false", dest="show",
                    help="the opposite, for a shell that has AGENTGLASS_BROWSER_SHOW=1")
    # On every verb, because the cost is not what a page returns — it is what
    # RE-ENTERS the caller's context and gets re-read every turn for the rest
    # of the session. --max-tokens truncates by relevance (viewport, then
    # newest-first); --out/--summary keep the body out of that context
    # entirely and hand back a path and a sentence instead.
    # ── WHO IS ASKING ────────────────────────────────────────────────────
    #
    # Several agents drive this browser at once, and the browser is built for
    # that: "if we want ten different agents working in forty-five completely
    # different tabs at the same time, I want that to be possible, and without
    # them stepping on each other".
    #
    # The rule was written in the skill and kept by nobody, and it was not
    # indiscipline: the easy path — a bare `open` — worked perfectly and landed
    # in the shared profile, which is the person's own cookies. A rule whose
    # violation costs nothing and shows nothing is not a rule.
    #
    # So identity is not something an agent remembers to ask for. It is what it
    # gets. Explicit name first, then the environment, then one derived from
    # the session — and `--shared` for the deliberate case of wanting to be in
    # the same place as everybody else.
    ap.add_argument("--as", "--profile", dest="asProfile", default=None, metavar="NAME",
                    help="work as this identity — its own cookies, storage and tabs. "
                         "Minted on first use. Without it, one is derived from your session")
    # TWO FLAGS, BECAUSE THEY WERE TWO MEANINGS WEARING ONE NAME.
    #
    # `--shared` said "the DEFAULT profile, which is the person's own session"
    # and did "whichever tab is in front, whoever owns it" — it cleared the
    # identity, and a request with no identity and no page is what the relay
    # reads as the active tab. Those are not the same tab and the difference is
    # the whole incident: an exemption that lands on a random agent's tab is
    # not an exemption.
    #
    # So `--shared` now means the person's container and nothing else, and the
    # other meaning gets its own word.
    ap.add_argument("--shared", action="store_true",
                    help="work in the person's OWN container — the default profile, the one "
                         "with their logins. Its tab is remembered like any identity's")
    ap.add_argument("--active", action="store_true",
                    help="act on whichever tab is in front, whoever owns it. The one way to "
                         "cross containers on purpose")
    # On every verb, because the server has accepted `page` on all of them all
    # along and only six declared it — so thirty-seven verbs could not name the
    # tab they meant and silently used whichever was in front. That is the
    # collision, and one global flag is the end of it.
    ap.add_argument("--page", default=None, metavar="TAB",
                    help="act on this tab instead of your own (see `tabs`)")
    ap.add_argument("--max-tokens", dest="maxTokens", type=int, default=None,
                    help="truncate the answer to roughly this many tokens, keeping what matters first")
    # dest is "outFile", not "out": `shot` already has its own positional `out`
    # (where to write the png) and the two must not collide on one namespace key.
    ap.add_argument("--out", dest="outFile", default=None, help="write the full answer here instead of stdout")
    ap.add_argument("--observe", action="store_true",
                    help="on a verb that ACTS, hand back the page it left behind under `after` — "
                         "one call instead of act-then-look. Costs an observation, so it is opt-in")
    ap.add_argument("--summary", action="store_true",
                    help="print one line describing the answer (with --out, alongside the path)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("open", help="go to a page and wait for it to load")
    p.add_argument("url")
    p = sub.add_parser("read", help="the page's url, title and visible text")
    p = sub.add_parser("click", help="click the first element matching a CSS selector")
    p.add_argument("selector")
    p = sub.add_parser("type", help="type into a field, optionally submitting it")
    p.add_argument("selector")
    p.add_argument("text")
    p.add_argument("--submit", action="store_true")
    p = sub.add_parser("wait", help="wait for an element to appear")
    p.add_argument("selector")
    p = sub.add_parser("shot", help="screenshot the page")
