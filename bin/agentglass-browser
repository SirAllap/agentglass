    p = sub.add_parser("cdp", help="one DevTools protocol command — the whole protocol, not a chosen slice")
    p.add_argument("method", nargs="?", help='e.g. Debugger.enable, DOMDebugger.setDOMBreakpoint, HeapProfiler.takeHeapSnapshot')
    p.add_argument("--params", help="JSON object for that command")
    p.add_argument("--events", action="store_true",
                   help="drain what CDP sent while nobody was asking: a debugger pause, a DOM breakpoint firing")
