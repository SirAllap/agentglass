    p.add_argument("--label", help="a caption next to --highlight's box")
    # DECLARED, because the code below already reads it. It did not, so every
    # `shot --out file.png` died on an AttributeError and exited 1 with nothing
    # written — and `--out` before the verb hit the global one, which skips
    # `shot` on purpose. Neither spelling produced a file. Both do now.
    # dest is its own name: the top-level parser already owns `--out` (as
    # `outFile`), and sharing a namespace with it left this one None at parse
    # time however it was spelled. Measured — `shot --out x.png` exited 0,
    # printed base64, and wrote nothing.
    p.add_argument("--out", dest="shotOut", help="write the png here instead of printing base64")
