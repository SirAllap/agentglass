        },
    },
    {
        "name": "browser_press",
        "description": "Press a key that is not text: Enter, Escape, Tab, arrows.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "observe": {"type": "boolean", "description": "Hand back the page this left behind, under `after` — one call instead of act-then-look. It costs a full observation, so ask for it on the step whose result you actually need."},"key": {"type": "string"}},
            "required": ["key"],
        },
    },
    {
        "name": "browser_back",
        "description": "Go back in this page's history.",
        "inputSchema": {"type": "object", "properties": {}},
    },
    {
        "name": "browser_forward",
        "description": "Go forward again.",
        "inputSchema": {"type": "object", "properties": {}},
    },
    {
        "name": "browser_shot",
        "description": (
            "A screenshot of the page, returned as an image. Works while the browser pane is behind "
            "another view, and frames the whole document rather than whatever fits in the pane: the "
            "pane's width, the browser's zoom and the display's DPI no longer change what is in the "
            "picture or how big the PNG is. Use selector for one element, clip for a rectangle. "
            "There is no full-page shot: it repeated any sticky header once per screen, and a "
            "picture that duplicates content is evidence that is simply wrong, and no scale "
            "option either — it tiled the page the same way. A shot is one pixel per css "
            "pixel, which is exactly what the page lays out."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "selector": {"type": "string", "description": "Crop to just this element."},
                "clip": {
                    "type": "object",
                    "description": "Crop to a rectangle in CSS pixels.",
                    "properties": {
                        "x": {"type": "number"}, "y": {"type": "number"},
                        "width": {"type": "number"}, "height": {"type": "number"},
                    },
                },
                "highlight": {"type": "string", "description": "Draw a box around this element, on the image."},
                "label": {"type": "string", "description": "A caption beside the highlight box."},
                "page": {"type": "string", "description": "A tab id, instead of the active tab."},
            },
        },
    },
]

VERB = {t["name"]: t["name"][len("browser_"):] for t in TOOLS}

# Verbs about the LIST of tabs, or about the window's session, rather than
# about a page inside one tab. Copied from bin/agentglass-browser's TAB_OPS,
# for the same reasons and with the same one that is easy to miss: `settings`
# has an argument of its OWN called `page` — the internal page a webview may
# render, and "blank" is its only allowed value. Putting a tab id there made
# every `settings set` answer `page must be "blank"`, which is a sentence about
# an argument the caller never passed.
#
# AND `whoami` IS IN IT, which is the one worth saying out loud: it is the verb
# that tells a caller whether it HAS a tab. Refusing it for not having one is a
# refusal nobody can answer — the same trap that cost the CLI's identity fix a
# first version and that gets worked around with "shared" on everything, which
# is the hole reopened by hand. Caught here by REQ-11's own MCP test, which
# asked `browser_whoami` with no tab and got the refusal sentence where it
# expected JSON.
TAB_OPS = {"tabs", "tab", "newtab", "closetab", "profiles", "whoami", "health", "settings"}

# `profile` and `shared` say WHO, not WHAT: they choose which tab this call is
# addressed to and never travel to the relay as part of the verb's body.
# `newtab` and `open` are the exception — for them a container IS the request,
# and the panel routes on it.
ADDRESSING = ("profile", "shared")


def _address_schemas():
    """Every acting tool advertises `page`, `profile` and `shared`.

    WRITTEN ONCE, HERE, RATHER THAN SIXTY TIMES IN THE LITERAL. The failure
    this avoids is measured on the other binary: six CLI verbs declared
    `--page` and exactly one sent it, so `shot --page t2-abc` quietly
    photographed the ACTIVE tab instead. A property added by hand to each
    schema is a property the next verb forgets, and forgetting it here is not a
    missing feature — it is a call that lands on somebody else's page.

    Existing properties are never overwritten: `browser_shot` already wrote its
    own `page`, and its wording is better than a generic one.
    """
    for t in TOOLS:
        if VERB[t["name"]] in TAB_OPS:
            continue
        props = t["inputSchema"].setdefault("properties", {})
        props.setdefault("page", {
            "type": "string",
            "description": "A tab id, instead of your own tab. browser_tabs lists them.",
        })
        props.setdefault("profile", {
            "type": "string",
            "description": "Act as this container rather than this client's own. Also what browser_open puts a new tab in.",
        })
        props.setdefault("shared", {
            "type": "boolean",
            "description": "Deliberately act on whichever tab is in front, even if it belongs to another agent. Without this, a client with no tab of its own is refused rather than sent there.",
        })


_address_schemas()


def _do_at(page, body):
    """`do`, addressed — on every STEP, because the top level is not read.

    MEASURED in server/src/index.ts: the `do` route hands `b.steps` straight to
    `runSteps` and never looks at `b.page`, so a page set beside `steps` is
    dropped in silence and the whole batch runs on whatever tab is in front —
    the exact failure this file is being fixed for, wearing the one verb that
    can do fifteen things before anybody notices.

    The server's own `lanes` path already does it the right way, stamping
    `args: {...st.args, page}` onto each step, so this is that same move
    applied to the single-lane form — and to any lane that did not name a page
    of its own, which keeps `lanes` the one thing this surface can express and
    the CLI cannot.
    """
    out = dict(body)
    if isinstance(out.get("lanes"), list):
        out["lanes"] = [dict(lane, page=lane.get("page") or page) if isinstance(lane, dict) else lane
                        for lane in out["lanes"]]
        return out
    out["steps"] = [dict(st, args=dict(st.get("args") or {}, page=page)) if isinstance(st, dict) else st
                    for st in (out.get("steps") or [])]
    return out


def _no_tab(name, who):
    """The refusal, when this client has no tab and did not ask for one.

    A REFUSAL RATHER THAN A FALL-THROUGH. A request with no `page` is not
    "unspecified" to the relay, it is "the tab in front", so an MCP client that
    believed itself isolated drove another container's page — `ok: true` every
    time, with no signal on either side, and the victim cannot see it either:
    it addresses its tab by id, the tab still exists, only the page inside
    changed.

    And this needs nobody to make a mistake. A client loses its remembered tab
    when the tab is closed, when an open failed, when the state file cannot be
    read, and when the app restarts — which invalidates every agent's
    remembered id at once.

    Every line below is an answer to it, which is why the refusal is safe to
    make: `browser_open` and `browser_newtab` always carry a container, so they
    never reach here and there is always a way to get a tab.
    """
    return {"content": [{"type": "text", "text": (
        f'{name}: "{who}" has no tab open, so this would have gone to whichever tab is in '
        f"front — which may belong to another agent.\n"
        f'  open one:      browser_open {{"url": "..."}}  — it lands in your own container\n'
        f'  or name a tab: {name} {{"page": "<tab id>"}}  — browser_tabs lists them\n'
        f'  or say you mean the active one: {name} {{"shared": true}}'
    )}], "isError": True}


def run(name, args):
    """A tool call, as MCP content."""
    verb = VERB.get(name)
    if not verb:
        return {"content": [{"type": "text", "text": f"no such tool: {name}"}], "isError": True}

    body = {}
    if verb == "do":
        body = {"observe": bool(args.get("observe"))}
        if args.get("lanes"):
            body["lanes"] = args["lanes"]
        else:
            body["steps"] = args.get("steps") or []
    elif verb == "addInitScript":
        body = {"name": args.get("name", ""), "js": args.get("js", "")}
    elif verb in ("expose", "exposed"):
        body = {"name": args.get("name", "")}
    elif verb in ("hover", "dblclick", "rightclick", "focus", "blur"):
        body = {"selector": args.get("selector", "")}
        if args.get("observe"):
            body["observe"] = True
    elif verb == "check":
        body = {"selector": args.get("selector", ""), "checked": args.get("checked", True)}
    elif verb == "fill":
        body = {"fields": args.get("fields") or {}, "submit": bool(args.get("submit"))}
    elif verb == "debug":
        body = {k: v for k, v in args.items() if v is not None}
    elif verb == "audit":
        body = {"script": bool(args.get("script"))}
    elif verb == "record":
        body = {k: v for k, v in args.items() if v is not None}
    elif verb == "download":
        body = {"selector": args.get("selector", ""), "dir": args.get("dir", "")}
        if args.get("timeoutMs") is not None:
            body["timeoutMs"] = args["timeoutMs"]
    elif verb in ("observe", "console", "network"):
        body = {k: v for k, v in args.items() if v is not None}
    elif verb == "events":
        body = {k: v for k, v in args.items() if v is not None}
    elif verb in ("emulate", "clock", "settings"):
        # Not from here: a model that can turn certificate checking off can be
        # talked into it by the page it is looking at, and the relay would
        # oblige. The field is gone from the schema above; a client that sends
        # it anyway gets a refusal, not a silent drop, so nobody reads "ok" as
        # "the cert warning is gone".
        if verb == "settings" and "ignoreCertErrors" in args:
            return {"content": [{"type": "text", "text": (
                "ignoreCertErrors is not available from the MCP tool: switching TLS verification off is "
                "a person's decision, made at the `agentglass-browser settings` command line."
            )}], "isError": True}
        body = {k: v for k, v in args.items() if v is not None}
    elif verb in ("profiles", "whoami"):
        # Straight through, both of them. The relay composes the answer out of
        # the container list and the tab list; what it needs from a caller is
        # only who that caller says it is.
        body = {k: v for k, v in args.items() if v is not None}
    elif verb == "cdp":
        body = {"events": True} if args.get("events") else {
            "method": args.get("method", ""), "params": args.get("params") or {}}
    elif verb == "listeners":
        body = {"selector": args.get("selector", "")}
    elif verb == "coverage":
        body = {"action": args.get("action", "start")}
    elif verb == "open":
        body = {"url": args.get("url", "")}
    elif verb in ("click", "wait", "text"):
        body = {"selector": args.get("selector", "")}
        if args.get("observe"):
            body["observe"] = True
    elif verb == "type":
        body = {"selector": args.get("selector", ""), "text": args.get("text", ""), "submit": bool(args.get("submit"))}
        if args.get("observe"):
            body["observe"] = True
    elif verb == "press":
        body = {"key": args.get("key", "")}
    elif verb == "newtab":
        # It had no branch at all, so it reached the server with an empty body:
        # the URL an agent asked for was dropped on the way and the tab opened
        # blank. The profile would have gone the same way.
        body = {"url": args.get("url", "")}
        # `profile` used to be forwarded here. It is set at the chokepoint
        # below instead, so a newtab with no profile named lands in THIS
        # client's container rather than the shared default — which is the
        # whole point — while a profile that is named still wins, and one that
        # does not exist is still refused by the panel rather than quietly
        # swapped for the current one.
    elif verb in ("tab", "closetab"):
        body = {}
        if args.get("index") is not None:
            body["index"] = args["index"]
        if args.get("id"):
            body["id"] = args["id"]
    elif verb == "scroll":
        if args.get("selector"):
            body = {"selector": args["selector"]}
        elif args.get("by") is not None:
            body = {"by": args["by"]}
        else:
            body = {"to": args.get("to", "bottom")}
    else:
        # THE ARGUMENTS OF 21 TOOLS WENT NOWHERE. Every verb without a branch
        # above left `body` at `{}`, so what the schema promised never reached
        # the relay: measured over TOOLS and this chain, 21 of the 57 tools
        # that take arguments dropped all 55 of their declared properties —
        # `eval`'s `js`, `upload`'s `paths`, `shot`'s `selector`, `clip` and
        # the `page` this whole change is about. The tool answered as though it
        # had worked, because a verb with an empty body is a valid request that
        # does something else.
        #
        # A default rather than 21 more branches, on purpose: a branch per verb
        # is what produced the 21, and the 22nd tool would join them.
        body = {k: v for k, v in args.items() if v is not None}

    # ── EVERY TOOL GOES TO THIS CLIENT'S OWN TAB ───────────────────────────
    #
    # Not "the active tab", which is whatever the person or the last agent left
    # in front. That default is right for somebody clicking around and wrong
    # for every agent that has ever used this: it is how two agents end up
    # typing into each other's page, and how a screenshot comes back showing
    # somebody else's work — "the other agent was going in to take screenshots
    # and could not, because the first one was overwriting on top of it."
    #
    # `page` still wins, the tab verbs are about the LIST rather than a page
    # inside one, and `settings` applies to the window's session — all three
    # are left alone, exactly as in bin/agentglass-browser.
    for key in ADDRESSING:
        body.pop(key, None)
    who = "" if args.get("shared") else my_name(args.get("profile"))
    mine = my_tab(who) if who else None
    sent_to = None

    if verb in ("open", "newtab") and who:
        # NAMING A TAB IS THE WHOLE ANSWER, and it is also the trap: an `open`
        # that carries a profile is routed by the panel to "make a tab in that
        # container", so setting both a page and a profile minted a NEW tab,
        # left the named one where it was, and answered with the new tab's URL
        # and title — which the caller reads as success.
        if verb == "open" and args.get("page"):
            body["page"] = sent_to = args["page"]
        elif verb == "open" and mine:
            # Already have one: GO there, do not make another. An agent that
            # calls open fifty times in a session means fifty pages, not fifty
            # tabs, and fifty tabs is how a browser runs out of room holding
            # the same page over and over.
            body["page"] = sent_to = mine
        else:
            body["profile"] = who
    elif verb not in TAB_OPS:
        target = args.get("page") or mine
        if not target:
            if who:
                return _no_tab(name, who)
        elif verb == "do":
            body = _do_at(target, body)
            sent_to = target
        else:
            body["page"] = sent_to = target

    # WHO IS ASKING, ON EVERY REQUEST. The panel's cross-container check reads
    # `as` and treats its ABSENCE as "cannot tell", which it must — a
    # hand-written client sends none — so a surface that never sends it turns
    # the check into a no-op for every tab it drives, and this one drove
    # whichever tab was in front for a whole incident. `how` rides with it for
    # the audit, and `pageExplicit` marks a page the AGENT named, as opposed to
    # the one this server filled in from the tab map: the two are the same
    # field on the wire and mean opposite things to the check.
    if who:
        body.setdefault("as", who)
        # And the ledger's name for the same thing. `open`/`newtab` mint
        # containers and `profiles` makes and drops them; without `identity`
        # every container this surface made had no creator, so the drop guard
        # treated it as unknown and let anybody take it.
        if verb in ("open", "newtab", "profiles"):
            body.setdefault("identity", who)
    if verb == "profiles":
        if args.get("identity"):
            body["identity"] = args["identity"]
        if args.get("force"):
            body["force"] = True
    if args.get("page"):
        body["pageExplicit"] = True
    body.setdefault("how", (
        "explicit-page" if args.get("page")
        else "shared" if not who
        else "own-tab" if sent_to
        else "own-container"))

    res = call(verb, body)
    # One retry, and only for the failure a retry can fix: no pane is mounted,
    # so nothing can answer until one is. "Not on screen" is deliberately NOT
    # retried — the capture works behind another view, and pulling the window
    # over to the browser is the app taking the screen off the person using it.
    if not res.get("ok") and "view is not open" in (res.get("error") or ""):
        # Ask again first. The panel re-registers itself for a moment when its
        # tab changes, and a call landing in that gap is told the view is not
        # open when it is — and opening it takes the screen off the person.
        time.sleep(0.5)
        res = call(verb, body)
    # AND THEN WAIT, RATHER THAN TAKE THE SCREEN.
    #
    # This used to switch the app to the browser view, and that is the single
    # most complained-about behaviour this tool has: "I am working away
    # quietly in my terminal… and it focuses the browser on me. I go back to
    # the terminal and it focuses the browser again… up to four, five, six
    # times." It is not a fix either: the browser panel is mounted from launch
    # whether or not anybody goes to it, so this error nearly always means the
    # window is still STARTING, and the answer to that is patience.
    if not res.get("ok") and "view is not open" in (res.get("error") or ""):
        if windows_ready(WAIT_TAIL):
            res = call(verb, body)

    # ── AND THE MAP IS KEPT HONEST ─────────────────────────────────────────
    #
    # A tab of ours that is gone stops being ours, so the next call opens a
    # fresh one instead of addressing a ghost forever — and a closed tab is a
    # reason to open another one, not a reason to stop.
    if sent_to and str(res.get("error") or "").startswith("no tab called"):
        forget_tab(who)
        if verb == "open" and who:
            body.pop("page", None)
            body["profile"] = who
            res = call(verb, body)
    if verb in ("open", "newtab") and who and body.get("profile") and not res.get("error"):
        made = res.get("value") if isinstance(res.get("value"), dict) else res
        remember_tab(who, (made or {}).get("id"))
    # AND `browser_tab` CHANGES WHICH TAB IS OURS.
    #
    # Selecting a tab and then capturing without `page` would otherwise give
    # the tab this client last OPENED, not the one just selected — a valid
    # picture of the wrong page, which is the same silent failure as the
    # incident with the parties swapped.
    #
    # WHAT WAS ASKED FOR, not what the answer calls active: the panel replies
    # with the list it had in hand, and the selection it has just made has not
    # reached that list yet, so reading the `active` flag off it records the
    # tab we were LEAVING — measured on the CLI, `tab t37` and the record still
    # said t38. The caller named one; that is not ambiguous.
    if verb == "closetab" and who and mine and args.get("id") == mine and not res.get("error"):
        forget_tab(who)
    if verb == "tab" and who and not res.get("error"):
        if args.get("id"):
            remember_tab(who, args["id"])
        elif args.get("index") is not None:
            rows = res.get("value") if isinstance(res.get("value"), list) else []
            i = int(args["index"])
            row = rows[i] if 0 <= i < len(rows) else None
            if isinstance(row, dict) and row.get("id"):
                remember_tab(who, row["id"])

    if verb == "do":
        # A batch answers per step, and a failure is not the whole batch
        # failing: the steps before it DID happen, and hiding them would send
        # the caller back to find out how far it got — which is the extra round
        # trip this verb exists to remove.
        lines = []
        for i, st in enumerate(res.get("steps") or []):
            if st.get("ok"):
                v = st.get("value")
                lines.append(f"{i + 1}. {st.get('op')}: {json.dumps(v) if v is not None else 'ok'}")
            else:
                lines.append(f"{i + 1}. {st.get('op')}: FAILED — {st.get('error') or 'no reason given'}")
                d = st.get("diagnosis")
                if d:
                    lines.append(f"   diagnosis: {json.dumps(d)}")
        if not res.get("ok"):
            lines.append("stopped here; the steps after this one did not run.")
        return {"content": [{"type": "text", "text": "\n".join(lines) or "no steps"}],
                "isError": not res.get("ok")}

    if not res.get("ok"):
        return {"content": [{"type": "text", "text": res.get("error") or "the browser could not do that"}], "isError": True}

    value = res.get("value") or {}
    if verb == "shot":
        png = value.get("png", "")
        data = png.split(",", 1)[1] if "," in png else ""
        if not data:
            return {"content": [{"type": "text", "text": "the page produced no image"}], "isError": True}
        return {"content": [
            {"type": "image", "data": data, "mimeType": "image/png"},
            {"type": "text", "text": f"{value.get('title', '')}\n{value.get('url', '')}"},
        ]}
    if verb in ("read", "text"):
        # Plain text, because the caller is a language model reading a page:
        # JSON around one string is punctuation it pays for.
        if verb == "text":
            return {"content": [{"type": "text", "text": value.get("text", "")}]}
        return {"content": [{"type": "text", "text": f"{value.get('title', '')}\n{value.get('url', '')}\n\n{value.get('text', '')}"}]}
    return {"content": [{"type": "text", "text": json.dumps(value)}]}


def reply(msg_id, result=None, error=None):
    out = {"jsonrpc": "2.0", "id": msg_id}
    if error is not None:
        out["error"] = error
    else:
        out["result"] = result
    sys.stdout.write(json.dumps(out) + "\n")
    sys.stdout.flush()


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue
        method = msg.get("method")
        msg_id = msg.get("id")
        # A notification has no id and takes no answer. `initialized` is the one
        # every client sends, and answering it is a protocol error.
        if msg_id is None:
            continue
        if method == "initialize":
            reply(msg_id, {
                "protocolVersion": PROTOCOL,
                "capabilities": {"tools": {}},
                "serverInfo": {"name": NAME, "version": VERSION},
                "instructions": (
                    "This is the person's own browser, in their window, signed in as they are. "
                    "They can see every page it opens. Open what the task needs and leave it "
                    "somewhere reasonable; do not go rummaging. The browser pane does not have "
                    "to be the view on screen — every tool works while they are reading "
                    "something else, and taking the screen off them is not part of the job.\n\n"
                    "OTHER AGENTS MAY BE DRIVING THIS SAME BROWSER. Start with browser_open: it "
                    "mints a tab in a container of your own, and every tool after it goes to that "
                    "tab, so nothing you do lands on somebody else's page and nothing they do "
                    "moves yours. Until you have one, any tool that acts on a page is refused "
                    "rather than sent to whichever tab is in front."
                ),
            })
        elif method == "tools/list":
            reply(msg_id, {"tools": TOOLS})
        elif method == "tools/call":
            params = msg.get("params") or {}
            reply(msg_id, run(params.get("name", ""), params.get("arguments") or {}))
        elif method == "ping":
            reply(msg_id, {})
        else:
            reply(msg_id, error={"code": -32601, "message": f"method not found: {method}"})
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (BrokenPipeError, KeyboardInterrupt):
        sys.exit(0)
