    {
        # §1. The spec opens on a shell loop — `for i in $(seq 1 20); do ...
        # done` — and that loop is the expensive thing: a process start and an
        # HTTP round trip per turn, and every answer parked in the context for
        # the rest of the session.
        "name": "browser_events",
        "description": (
            "WAIT for something to happen, instead of polling. One call that returns the MOMENT "
            "there is a console message, a network response or a DevTools event — or says nothing "
            "happened, which is an answer and not a failure. Use this instead of calling "
            "browser_console or browser_network in a loop: the waiting happens on the server, so it "
            "costs you ONE answer in your context rather than twenty. Carry the `now` from each "
            "reply into the next `since` and you never re-read what you already saw."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "wait": {"type": "number", "description": "Seconds to wait, 0 to 120 (default 30)."},
                "since": {"type": "number", "description": "Epoch ms — the `now` from your last reply."},
