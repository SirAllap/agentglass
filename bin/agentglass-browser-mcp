#!/usr/bin/env python3
"""agentglass's browser, as an MCP server.

The same browser the person is looking at — signed in to the same sites, in the
same window — offered to an agent as tools with schemas instead of a shell
command whose output has to be parsed back out of a terminal.

WHY NOT chrome-devtools-mcp. It is the obvious answer and it is the wrong one
here: it drives a Chrome over CDP, and pointing it at this app means starting
Electron with `--remote-debugging-port`, which opens the WHOLE application over
CDP — not the page: the app's own renderer too, where the API token lives. Any
process on the machine could then read it and drive everything. This server
reaches the browser the way the CLI does, through the relay the app already has
(`POST /browser/<verb>` → the panel → the guest), so what an agent can do is
exactly what that relay exposes and nothing else — the app's own renderer, and
the token in it, stay out of reach.

WHAT ACTS. Four of these tools run code or reach the debugger of the PAGE, and
this docstring used to say the opposite ("there is no 'run this JavaScript'
tool") from before they existed: `browser_eval` runs JavaScript in the page,
`browser_addInitScript` installs JavaScript that runs before every page does,
`browser_expose` gives the page a function that calls back into the caller,
and `browser_cdp` sends raw Chrome DevTools Protocol commands to the guest's
session. All four are confined to the guest page — none of them reaches the
app's renderer — and all four count as ACTING under AGENTGLASS_BROWSER_READONLY.

Transport is stdio with one JSON-RPC message per line, which is what the MCP
stdio transport is. No dependencies: this has to run on a machine where the app
is installed, not one where a package tree was.

    claude mcp add agentglass-browser -- agentglass-browser-mcp

Environment:
    AGENTGLASS_SERVER   default http://localhost:4000
    AGENTGLASS_TOKEN    only needed if the server was started with one
"""
import json
import os
import re
import sys
import time
import urllib.error
import urllib.request


def _server_or_die(url):
    """Where the Bearer token goes. It is sent to whatever AGENTGLASS_SERVER
    names, and over plain http to a remote host it travels in the clear —
    every hop between here and there reads it. So: https anywhere, http only
    to this machine (localhost, or a loopback address). Anything else is one
    line on stderr and exit 2, before a single request is built."""
    import ipaddress
    from urllib.parse import urlsplit
    u = urlsplit(url)
    host = (u.hostname or "").lower()
    if u.scheme == "https" and host:
        return url
    if u.scheme == "http" and host:
        loop = host == "localhost"
        if not loop:
            try:
                loop = ipaddress.ip_address(host).is_loopback
            except ValueError:
                loop = False
        if loop:
            return url
        print(f"agentglass: refusing plain http to {host}: the token would travel in the clear. "
              f"Use https://, or http:// only to localhost/127.0.0.1/::1 (AGENTGLASS_SERVER={url})", file=sys.stderr)
        sys.exit(2)
    print(f"agentglass: AGENTGLASS_SERVER must be https://<host> or http://<loopback>, got {url!r}", file=sys.stderr)
    sys.exit(2)


SERVER = _server_or_die(os.environ.get("AGENTGLASS_SERVER", "http://localhost:4000").rstrip("/"))
PROTOCOL = "2025-06-18"
NAME = "agentglass-browser"
VERSION = "1.0.0"


def call(op, body, timeout=120):
    """One verb, through the app's relay. Every failure comes back as an answer
    rather than an exception: the caller is a model, and a stack trace on stdout
    would also break the transport."""
    req = urllib.request.Request(
        f"{SERVER}/browser/{op}",
        data=json.dumps(body).encode(),
        method="POST",
        headers={
            "Content-Type": "application/json",
            # Same-origin is how the server tells a browser tab from everything
            # else; a program on this machine says so plainly.
            "Origin": SERVER,
        },
    )
    token = os.environ.get("AGENTGLASS_TOKEN")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            return json.loads(e.read() or b"{}")
        except json.JSONDecodeError:
            return {"ok": False, "error": f"server said {e.code}"}
    except urllib.error.URLError as e:
        return {"ok": False, "error": f"no agentglass at {SERVER} ({e.reason})"}



# ── identity ────────────────────────────────────────────────────────────────
#
# WHO IS DRIVING, AND WHICH TAB IS THEIRS. This surface had neither: `grep -c
# 'my_name\|my_tab\|remember_tab' bin/agentglass-browser-mcp` returned 0, so
# all 65 tools sent a body with no `page` in it — and a request that names no
# tab is not "unspecified" to the relay, it is "the tab in front", whoever owns
# it. That is the incident seen from this side of the same relay: "another
# agent was getting into that container and putting its data into that
# screen… the other agent was going in to take screenshots and could not,
# because the first one was overwriting on top of it."
#
# STATE_DIR and the file name are COPIED from bin/agentglass-browser rather
# than chosen, so a session's shell and its MCP client are one identity holding
# one tab. An agent that opens a page with the CLI and then reads it through
# this server has to land on the same tab; a second, private map would have
# made those two into exactly the two agents this fix is about.
#
# The intended end state is one module both binaries import — the same contract
# cannot be kept in two files forever. Until then the rules below are a literal
# copy, and server/test/browser-mcp.test.ts asserts the two agree on the file
# and on the name so the copies cannot drift apart in silence.
STATE_DIR = (os.environ.get("AGENTGLASS_BROWSER_STATE_DIR")
             or os.path.expanduser("~/.cache/agentglass-browser"))


def my_name(explicit=None):
    """The identity this server works as.

    Explicit name, then AGENTGLASS_PROFILE, then one derived from the session,
    so that an agent has an identity WITHOUT having thought about it — because
    "declare your identity on every call" is a rule that is kept for ten
    minutes and then quietly stops being kept: "the agents are using the browser
    but not creating their profiles; I have to tell them myself."
    """
    if explicit:
        return explicit[:24]
    env = os.environ.get("AGENTGLASS_PROFILE")
    if env:
        return env[:24]
    root = os.environ.get("CLAUDE_PROJECT_ROOT") or os.getcwd()
    stem = re.sub(r"[^A-Za-z0-9]", "", os.path.basename(root.rstrip("/")))[:12] or "agent"
    seed = (os.environ.get("CLAUDE_CODE_SESSION_ID")
            or os.environ.get("TMUX_PANE", "").lstrip("%")
            or str(os.getppid()))
    tail = re.sub(r"[^A-Za-z0-9]", "", seed)[-6:] or "0"
    return f"{stem}-{tail}"[:24]


def _tabs_path():
    return os.path.join(STATE_DIR, "my-tabs.json")


def my_tab(name):
    """The tab this identity opened, if it still has one."""
    try:
        with open(_tabs_path()) as f:
            return (json.load(f) or {}).get(name) or None
    except Exception:
        return None


def remember_tab(name, tab_id):
    """Written after `open`/`newtab`/`tab` so every later tool can name it.

    Best effort: a state file that cannot be written costs the automatic
    targeting, not the call — the caller can always pass `page` itself.
    """
    if not name or not tab_id:
        return
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        try:
            with open(_tabs_path()) as f:
                held = json.load(f) or {}
        except Exception:
            held = {}
        held[name] = tab_id
        tmp = _tabs_path() + ".tmp"
        with open(tmp, "w") as f:
            json.dump(held, f)
        os.replace(tmp, _tabs_path())
    except Exception:
        pass


def forget_tab(name):
    """After a tab is closed, or found to be gone."""
    try:
        with open(_tabs_path()) as f:
            held = json.load(f) or {}
        if held.pop(name, None) is None:
            return
        tmp = _tabs_path() + ".tmp"
        with open(tmp, "w") as f:
            json.dump(held, f)
        os.replace(tmp, _tabs_path())
    except Exception:
        pass


# How long to keep waiting for a window that is still starting, once the quick
# look has already failed. Bounded on purpose: nothing opens a pane any more —
# that was the screen theft — so all this can do is wait and then say so, and an
# agent blocked for ten seconds is its own kind of theft.
WAIT_TAIL = float(os.environ.get("AGENTGLASS_BROWSER_WAIT") or 2.5)


def windows_ready(seconds=1.6):
    """Wait for a window to say it can drive a browser.

    The app registers itself a moment after its renderer is up, and a restart is
    seconds of that moment — so a call landing in it is told "the browser view
    is not open" about a window that is simply still starting. Switching the app
    to the browser then is the worst possible answer: it takes the screen off
    whoever is using it, and it happens EVERY time, which is what was reported —
    "every reinstall drags me to the browser view… three or four times over".

    So the wait comes first. This is a read; it opens nothing and moves nothing.
    """
    deadline = time.time() + seconds
    while True:
        req = urllib.request.Request(f"{SERVER}/browser-use/status")
        token = os.environ.get("AGENTGLASS_TOKEN")
        if token:
            req.add_header("Authorization", f"Bearer {token}")
        try:
            with urllib.request.urlopen(req, timeout=3) as r:
                if json.loads(r.read()).get("windows", 0) > 0:
                    return True
        except Exception:
            # Nothing to wait FOR: a server that cannot be asked is not a window
            # that is starting, and waiting five seconds to find that out is
            # five seconds an agent spends learning nothing.
            return False
        if time.time() >= deadline:
            return False
        time.sleep(0.4)


def open_browser_view():
    """Ask the window to show the browser pane.

    The pane is where the guest lives, so nothing can answer until it is
    mounted. Used for one failure only — see `run`."""
    req = urllib.request.Request(
        f"{SERVER}/control",
        data=json.dumps({"cmd": "view", "to": "browser"}).encode(),
        method="POST",
        headers={"Content-Type": "application/json", "Origin": SERVER},
    )
    token = os.environ.get("AGENTGLASS_TOKEN")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            r.read()
        return True
    except Exception:
        return False


