# Expo pins react to what the SDK was built against (19.2.3 for SDK 57), while
# expo-router pulls a radix tree whose react-dom asks for ^19.2.8. Both are
# right and neither will move for us, so npm's strict peer resolution refuses
# to add ANY new dependency to this project — the conflict is transitive and
# has nothing to do with the package being installed.
#
# It lives here rather than on a command line so `npm ci` resolves the same
# tree as `npm install` does on a laptop. Without it the two disagree and the
# build that breaks is the one nobody ran locally.
#
# That sentence used to say "npm ci in CI", and for a long time there was no
# `npm ci` in CI: `grep -rln mobile .github/workflows/` returned nothing, so
# this file justified itself against a job that did not exist. The job is real
# now — the `mobile` job in .github/workflows/ci.yml, `Install (mobile)`.
legacy-peer-deps=true
