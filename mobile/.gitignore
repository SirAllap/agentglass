# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects are generated by `expo prebuild`, never edited by hand and
# never committed: .github/workflows/android-apk.yml regenerates them from
# app.json on every run, so a checked-in copy is a second source of truth that
# silently wins over the config — plugins/with-release-signing.js included,
# since it only exists inside prebuild's output. The cost of regenerating is
# 2 seconds, measured; README.md ("android/ is generated, not committed") has
# the numbers it is weighed against.
/android
/ios

# Metro
.metro-health-check*

# Debug
npm-debug.*
*.log

# The xterm bundle, built by `npm run build:engine` on postinstall.
# 380KB of minified engine that would otherwise land in the diff of every
# dependency bump, with nobody able to tell whether it matches package.json.
src/terminal/engine.generated.ts

# The icon font as base64, built by `npm run build:font` on postinstall. The
# woff2 it is made from IS committed, next to it; this is 349KB on one line.
src/terminal/nerdfont.generated.ts
.qa/
.qa-shots/
